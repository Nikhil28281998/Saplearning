{
  "xsappname": "saplearningcenter-app",
  "authorities-inheritance": true,
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Full admin access"
    },
    {
      "name": "$XSAPPNAME.Manager",
      "description": "Manager access to team assignments"
    },
    {
      "name": "$XSAPPNAME.User",
      "description": "End user access to own assignments"
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Administrator",
      "scope-references": [ "$XSAPPNAME.Admin" ]
    },
    {
      "name": "Manager",
      "description": "Manager",
      "scope-references": [ "$XSAPPNAME.Manager" ]
    },
    {
      "name": "User",
      "description": "End User",
      "scope-references": [ "$XSAPPNAME.User" ]
    }
  ],
  "attributes": []
}
