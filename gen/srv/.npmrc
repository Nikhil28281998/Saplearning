# SAP NPM Registry Configuration
# Required for @sap/* packages in corporate networks

@sap:registry=https://npm.sap.com
registry=https://registry.npmjs.org/

# Uncomment and set token for private SAP registry access
# //npm.sap.com/:_authToken=${SAP_NPM_TOKEN}

# SSL/TLS Configuration
strict-ssl=true

# Cache configuration
cache=~/.npm

# Logging
loglevel=warn
