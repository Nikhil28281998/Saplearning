<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:macros="sap.fe.macros"
    controllerName="saplearningcenter.saplearningcenter.ext.main.Main">
    <Page id="Main" title="{i18n>MainTitle}">
        <content>
            <macros:FilterBar id="FB" contextPath="/Entity1" metaPath="@UI.SelectionFields" p13nMode="Value">
                <macros:FilterField propertyPath="role" dataType="Edm.String"/>
                <macros:FilterField propertyPath="module" dataType="Edm.String"/>
                <macros:FilterField propertyPath="title" dataType="Edm.String"/>
            </macros:FilterBar>

            <macros:Table id="TBL" contextPath="/Entity1" metaPath="@UI.LineItem" filterBar="FB" selectionMode="None" busyIndicatorDelay="0">
                <columns>
                    <macros:Column property="title"/>
                    <macros:Column property="description"/>
                    <macros:Column property="lastUpdated"/>
                    <macros:Column property="module"/>
                    <macros:Column property="role"/>
                </columns>
            </macros:Table>

            <Button id="aiFab" icon="sap-icon://ai" type="Emphasized" tooltip="AI Assistant" press="onOpenAI" class="aiFab"/>
        </content>
    </Page>
</mvc:View>