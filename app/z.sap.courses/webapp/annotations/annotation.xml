<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Alias="UI" Namespace="com.sap.vocabularies.UI.v1"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
    </edmx:Reference>
    <edmx:Reference Uri="/sap/opu/odata/sap/ZCOURSES_SRV/$metadata">
        <edmx:Include Alias="SAPLearningService" Namespace="ZCOURSES_SRV"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="z.sap.courses.annotations">

            <!-- ========== Training Entity ========== -->
            <Annotations Target="ZCOURSES_SRV.Training">

                <!-- SmartFilterBar: which fields appear as filter inputs (rectangles) -->
                <!-- Title removed: basic search box handles title search -->
                <!-- Role + SapModule: custom filterGroupItems with cross-reference dropdowns -->
                <Annotation Term="UI.SelectionFields">
                    <Collection>
                        <PropertyPath>Role</PropertyPath>
                        <PropertyPath>SapModule</PropertyPath>
                        <PropertyPath>LastUpdated</PropertyPath>
                    </Collection>
                </Annotation>

                <!-- SmartTable: columns and their responsive importance -->
                <Annotation Term="UI.LineItem">
                    <Collection>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Title"/>
                            <PropertyValue Property="Label" String="Title"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Role"/>
                            <PropertyValue Property="Label" String="Role"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="SapModule"/>
                            <PropertyValue Property="Label" String="Module"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Description"/>
                            <PropertyValue Property="Label" String="Description"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Medium"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="LastUpdated"/>
                            <PropertyValue Property="Label" String="Last Updated"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Low"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Url"/>
                            <PropertyValue Property="Label" String="Training Link"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Medium"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="SapHelpLink"/>
                            <PropertyValue Property="Label" String="SAP Help"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Low"/>
                        </Record>
                    </Collection>
                </Annotation>

                <Annotation Term="Capabilities.DeleteRestrictions">
                    <Record>
                        <PropertyValue Property="Deletable" Bool="true"/>
                    </Record>
                </Annotation>

                <Annotation Term="UI.HeaderInfo">
                    <Record>
                        <PropertyValue Property="TypeName" String="Training"/>
                        <PropertyValue Property="TypeNamePlural" String="Trainings"/>
                        <PropertyValue Property="Title">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value" Path="Title"/>
                            </Record>
                        </PropertyValue>
                        <PropertyValue Property="Description">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value" Path="SapModule"/>
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>

                <Annotation Term="UI.Facets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="Label" String="Details"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Main"/>
                        </Record>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.FieldGroup" Qualifier="Main">
                    <Record>
                        <PropertyValue Property="Data">
                            <Collection>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="Title"/>
                                    <PropertyValue Property="Label" String="Title"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="Description"/>
                                    <PropertyValue Property="Label" String="Description"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="Role"/>
                                    <PropertyValue Property="Label" String="Role"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="SapModule"/>
                                    <PropertyValue Property="Label" String="Module"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="LastUpdated"/>
                                    <PropertyValue Property="Label" String="Last Updated"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="Url"/>
                                    <PropertyValue Property="Label" String="Primary Link"/>
                                </Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="SapHelpLink"/>
                                    <PropertyValue Property="Label" String="SAP Help"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

            <!-- ========== TrainingAssignment Entity ========== -->
            <Annotations Target="ZCOURSES_SRV.TrainingAssignment">

                <Annotation Term="UI.SelectionFields">
                    <Collection>
                        <PropertyPath>Status</PropertyPath>
                        <PropertyPath>UserId</PropertyPath>
                        <PropertyPath>Title</PropertyPath>
                        <PropertyPath>SapModule</PropertyPath>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.LineItem">
                    <Collection>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Title"/>
                            <PropertyValue Property="Label" String="Training"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="SapModule"/>
                            <PropertyValue Property="Label" String="Module"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="UserId"/>
                            <PropertyValue Property="Label" String="User ID"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="UserName"/>
                            <PropertyValue Property="Label" String="User Name"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Medium"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Status"/>
                            <PropertyValue Property="Label" String="Status"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="DueDate"/>
                            <PropertyValue Property="Label" String="Due Date"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Medium"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="CompletionDate"/>
                            <PropertyValue Property="Label" String="Completed"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/Low"/>
                        </Record>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.HeaderInfo">
                    <Record>
                        <PropertyValue Property="TypeName" String="Assignment"/>
                        <PropertyValue Property="TypeNamePlural" String="Assignments"/>
                        <PropertyValue Property="Title">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value" Path="Title"/>
                            </Record>
                        </PropertyValue>
                        <PropertyValue Property="Description">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value" Path="Status"/>
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

            <!-- ========== User Entity (Value Help) ========== -->
            <Annotations Target="ZCOURSES_SRV.User">
                <Annotation Term="UI.SelectionFields">
                    <Collection>
                        <PropertyPath>UserId</PropertyPath>
                        <PropertyPath>FirstName</PropertyPath>
                        <PropertyPath>LastName</PropertyPath>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.LineItem">
                    <Collection>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="UserId"/>
                            <PropertyValue Property="Label" String="User ID"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="FirstName"/>
                            <PropertyValue Property="Label" String="First Name"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="LastName"/>
                            <PropertyValue Property="Label" String="Last Name"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Email"/>
                            <PropertyValue Property="Label" String="Email"/>
                        </Record>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.HeaderInfo">
                    <Record>
                        <PropertyValue Property="TypeName" String="User"/>
                        <PropertyValue Property="TypeNamePlural" String="Users"/>
                        <PropertyValue Property="Title">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value" Path="UserId"/>
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
