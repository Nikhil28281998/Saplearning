{
  "_version": "1.60.0",
  "sap.app": {
    "id": "z.sap.courses",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "archeType": "transactional",
    "registrationIds": [
      "z.sap.courses"
    ],
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.20.0",
      "toolsId": "88f74be8-a6aa-4c10-b1cf-73cb0004ddaf"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZCOURSES_SRV_0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "sap-courses-display": {
          "semanticObject": "ZLEARNING",
          "action": "display",
          "title": "{{sap-courses-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "my-trainings": {
          "semanticObject": "ZLEARNING",
          "action": "mytrainings",
          "title": "{{myTrainingsTileTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.13",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {},
        "sap.fe.macros": {},
        "sap.f": {}
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "z.sap.courses.ext.TrainingsListExtension"
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "z.sap.courses.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsBeginExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        },
        "routerClass": "sap.f.routing.Router"
      },
      "routes": [
        {
          "name": "TrainingsList",
          "pattern": ":?query:",
          "target": "TrainingsList"
        },
        {
          "name": "TrainingsObjectPage",
          "pattern": "Trainings({key})",
          "target": "TrainingsObjectPage"
        },
        {
          "name": "TrainingAssignmentsList",
          "pattern": "TrainingAssignments",
          "target": "TrainingAssignmentsList"
        },
        {
          "name": "TrainingAssignmentsObjectPage",
          "pattern": "TrainingAssignments({key})",
          "target": "TrainingAssignmentsObjectPage"
        },
        {
          "name": "UsersList",
          "pattern": "Users",
          "target": "UsersList"
        },
        {
          "name": "UsersObjectPage",
          "pattern": "Users({key})",
          "target": "UsersObjectPage"
        },
        {
          "name": "MyTrainingsList",
          "pattern": "MyTrainings",
          "target": "TrainingAssignmentsList"
        }
      ],
      "targets": {
        "TrainingsList": {
          "type": "Component",
          "id": "TrainingsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Trainings",
              "navigation": {
                "Trainings": {
                  "detail": {
                    "route": "TrainingsObjectPage"
                  }
                }
              }
            }
          },
          "controlAggregation": "beginColumnPages"
        },
        "TrainingsObjectPage": {
          "type": "Component",
          "id": "TrainingsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Trainings"
            }
          },
          "controlAggregation": "midColumnPages"
        },
        "TrainingAssignmentsList": {
          "type": "Component",
          "id": "TrainingAssignmentsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "TrainingAssignments"
            }
          },
          "controlAggregation": "beginColumnPages"
        },
        "TrainingAssignmentsObjectPage": {
          "type": "Component",
          "id": "TrainingAssignmentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "TrainingAssignments"
            }
          },
          "controlAggregation": "midColumnPages"
        },
        "UsersList": {
          "type": "Component",
          "id": "UsersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Users"
            }
          },
          "controlAggregation": "beginColumnPages"
        },
        "UsersObjectPage": {
          "type": "Component",
          "id": "UsersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Users"
            }
          },
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  },
  "sap.fiori": {}
}