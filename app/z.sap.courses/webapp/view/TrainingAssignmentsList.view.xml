<mvc:View
    controllerName="z.sap.courses.controller.TrainingAssignmentsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">

    <Page
        id="assignmentsListPage"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press="onNavBack" type="Back" />
                    <Title text="Training Assignments" level="H2" />
                </contentLeft>
                <contentRight>
                    <Button
                        text="Back to Catalog"
                        icon="sap-icon://learning-assistant"
                        press="onNavBack" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- SmartFilterBar for Assignments -->
            <smartFilterBar:SmartFilterBar
                id="assignSmartFilterBar"
                entitySet="TrainingAssignments"
                persistencyKey="AssignmentsSmartFilter"
                enableBasicSearch="true"
                showClearOnFB="true" />

            <!-- SmartTable for Assignments -->
            <smartTable:SmartTable
                id="assignSmartTable"
                entitySet="TrainingAssignments"
                smartFilterId="assignSmartFilterBar"
                tableType="ResponsiveTable"
                header="Assignments"
                showRowCount="true"
                enableAutoBinding="true"
                showFullScreenButton="true"
                useExportToExcel="true"
                useVariantManagement="true"
                useTablePersonalisation="true"
                persistencyKey="AssignmentsSmartTable"
                demandPopin="true"
                enableAutoColumnWidth="true"
                initialise="onSmartTableInit">

                <smartTable:customToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="Refresh Data"
                            press="onRefresh" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
