<mvc:View
    controllerName="z.sap.courses.controller.TrainingAssignmentsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:filterBar="sap.ui.comp.filterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:f="sap.f"
    xmlns:cssgrid="sap.ui.layout.cssgrid">

    <Page
        id="assignmentsListPage"
        title="{i18n>myAssignments}"
        showNavButton="true"
        navButtonPress="onNavBack"
        navButtonTooltip="{i18n>backToCourses}"
        enableScrolling="true"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content assignmentsPage">

        <headerContent />

        <dependents>
            <core:InvisibleText id="assignmentsFilterLabel" text="{i18n>assignmentsFilterLabel}" />
            <core:InvisibleText id="assignmentsTableLabel" text="{i18n>assignmentsTableLabel}" />
            <core:InvisibleText id="assignRefreshLabel" text="{i18n>refreshData}" />
        </dependents>

        <content>
            <!-- ============================================================ -->
            <!-- U-3: Due Date Warning Banner                                  -->
            <!-- ============================================================ -->
            <HBox id="dueDateWarningBanner"
                  class="dueDateWarningBar sapUiSmallMarginBottom sapUiSmallMarginBeginEnd"
                  alignItems="Center"
                  visible="{= ${assignAnalytics>/dueSoonCount} > 0 }">
                <core:Icon id="dueDateWarningIcon" src="sap-icon://warning2" size="1.25rem" color="#e76500" class="sapUiTinyMarginEnd" />
                <Text id="dueDateWarningText"
                      text="{= ${assignAnalytics>/dueSoonCount} === 1 ? '1 assignment is due within 3 days!' : ${assignAnalytics>/dueSoonCount} + ' assignments are due within 3 days!'}"
                      class="sapUiTinyMarginEnd" />
                <Button id="dueDateWarningBtn" text="{i18n>viewDueSoon}" type="Transparent" press="onFilterDueSoon" />
            </HBox>

            <!-- ============================================================ -->
            <!-- U-4: Gamification Achievement Banner                          -->
            <!-- ============================================================ -->
            <HBox id="gamificationBanner"
                  class="gamificationBanner sapUiSmallMarginBottom sapUiSmallMarginBeginEnd"
                  alignItems="Center"
                  visible="{= ${assignAnalytics>/badge} !== '' }">
                <core:Icon id="gamificationIconBadge" src="{assignAnalytics>/badgeIcon}" size="1.5rem" color="#f59e0b" class="gamificationIcon" />
                <VBox id="gamificationTextBox">
                    <Text id="gamificationBadgeText" text="{assignAnalytics>/badge}" class="gamificationText" />
                    <Text id="gamificationSubtext" text="{assignAnalytics>/badgeDescription}" class="gamificationSubtext" />
                </VBox>
            </HBox>

            <!-- ============================================================ -->
            <!-- MY PROGRESS – User's own assignment stats (always visible)   -->
            <!-- ============================================================ -->
            <Panel
                id="myProgressPanel"
                expandable="true"
                expanded="true"
                headerText="{i18n>myProgress}"
                class="sapUiSmallMarginBottom analyticsPanel">

                <!-- Hero Completion Card -->
                <VBox id="completionHeroCard" class="completionBarCard sapUiSmallMargin">
                    <HBox id="completionHeroHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                        <core:Icon id="completionHeroIcon" src="sap-icon://competitor" size="1.25rem" color="#6c32a9" class="sapUiTinyMarginEnd" />
                        <Title id="completionHeroTitle" text="{i18n>yourCompletion}" level="H5" />
                        <Text id="completionHeroPct" text="{= ${assignAnalytics>/completionPercent} + '%' }" class="sapUiSmallMarginBegin completionPctLabel" />
                    </HBox>
                    <ProgressIndicator
                        id="completionHeroBar"
                        percentValue="{assignAnalytics>/completionPercent}"
                        displayValue="{= ${assignAnalytics>/completionPercent} + '%' }"
                        state="{= ${assignAnalytics>/completionPercent} >= 80 ? 'Success' : ${assignAnalytics>/completionPercent} >= 50 ? 'Warning' : 'Information' }"
                        showValue="true"
                        height="2.5rem"
                        class="teamCompletionProgressBar" />
                    <Text id="completionHeroSubtitle"
                        text="{= 'Completed: ' + ${assignAnalytics>/completed} + '  |  Remaining: ' + (${assignAnalytics>/total} - ${assignAnalytics>/completed}) }"
                        class="motivationalText sapUiTinyMarginTop" />
                </VBox>

                <VBox id="myProgressHBox" class="sapUiSmallMargin analyticsContainer userAnalyticsContainer">
                    <VBox id="myAssignedBox" alignItems="Center" class="analyticsCard analyticsCardOrange">
                        <core:Icon id="myAssignedIcon" src="sap-icon://pending" size="1.5rem" color="#e76500" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="myAssignedCount"
                            number="{assignAnalytics>/assigned}"
                            state="Warning"
                            class="analyticsNumber" />
                        <Text id="myAssignedLabel" text="{i18n>toStart}" class="analyticsLabel" />
                    </VBox>

                    <VBox id="myInProgressBox" alignItems="Center" class="analyticsCard analyticsCardBlue">
                        <core:Icon id="myInProgressIcon" src="sap-icon://activity-2" size="1.5rem" color="#0854a0" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="myInProgressCount"
                            number="{assignAnalytics>/inProgress}"
                            state="Information"
                            class="analyticsNumber" />
                        <Text id="myInProgressLabel" text="{i18n>inProgress}" class="analyticsLabel" />
                    </VBox>

                    <VBox id="myOverdueBox" alignItems="Center" class="analyticsCard analyticsCardRed">
                        <core:Icon id="myOverdueIcon" src="sap-icon://alert" size="1.5rem" color="#bb0000" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="myOverdueCount"
                            number="{assignAnalytics>/overdue}"
                            state="Error"
                            class="analyticsNumber" />
                        <Text id="myOverdueLabel" text="{i18n>overdue}" class="analyticsLabel" />
                    </VBox>

                    <VBox id="myCompletedBox" alignItems="Center" class="analyticsCard analyticsCardGreen">
                        <core:Icon id="myCompletedIcon" src="sap-icon://accept" size="1.5rem" color="#107e3e" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="myCompletedCount"
                            number="{assignAnalytics>/completed}"
                            state="Success"
                            class="analyticsNumber" />
                        <Text id="myCompletedLabel" text="{i18n>completed}" class="analyticsLabel" />
                    </VBox>
                </VBox>
            </Panel>

            <!-- SmartFilterBar for Assignments -->
            <smartFilterBar:SmartFilterBar
                id="assignSmartFilterBar"
                entitySet="TrainingAssignments"
                persistencyKey="AssignmentsSmartFilter"
                ariaLabelledBy="assignmentsFilterLabel"
                enableBasicSearch="true"
                showClearOnFB="false"
                showRestoreOnFB="false"
                showGoOnFB="true"
                filterBarExpanded="true"
                showFilterConfiguration="true"
                useDateRangeType="true">
                <smartFilterBar:controlConfiguration>
                    <smartFilterBar:ControlConfiguration id="ccAssignModule" key="SapModule" filterType="single" />
                </smartFilterBar:controlConfiguration>
                <smartFilterBar:filterGroupItems>
                    <filterBar:FilterGroupItem
                        id="fgiAssignStatus"
                        name="Status"
                        label="{i18n>statusLabel}"
                        groupName="_BASIC"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <Select id="filterAssignStatus" forceSelection="false" selectedKey="">
                                <core:Item id="assignStatusAll" key="" text="{i18n>allItems}" />
                                <core:Item id="assignStatusAssigned" key="Assigned" text="{i18n>statusAssigned}" />
                                <core:Item id="assignStatusInProgress" key="In Progress" text="{i18n>inProgress}" />
                                <core:Item id="assignStatusCompleted" key="Completed" text="{i18n>completed}" />
                                <core:Item id="assignStatusOverdue" key="Overdue" text="{i18n>overdue}" />
                            </Select>
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                </smartFilterBar:filterGroupItems>
            </smartFilterBar:SmartFilterBar>

            <!-- ====== CARD GRID VIEW (Learning Hub style) ====== -->
            <ScrollContainer
                id="assignCardScrollContainer"
                height="100%"
                width="100%"
                vertical="true"
                horizontal="false"
                visible="{assignViewMode>/showCards}">
                <VBox id="assignCardGridWrapper" class="cardGridWrapper">
                    <!-- Card count + View toggle toolbar -->
                    <Toolbar id="assignCardToolbar" class="sapUiSmallMarginBottom">
                        <Title id="assignCardCountTitle" text="{= 'My Assignments (' + ${assignViewMode>/cardCount} + ')' }" level="H5" />
                        <ToolbarSpacer id="assignCardToolbarSpacer1" />
                        <SegmentedButton id="assignViewModeToggle" selectedKey="{assignViewMode>/mode}" selectionChange="onAssignViewModeChange">
                            <items>
                                <SegmentedButtonItem id="assignViewModeCards" key="cards" icon="sap-icon://grid" tooltip="Card View" />
                                <SegmentedButtonItem id="assignViewModeTable" key="table" icon="sap-icon://table-view" tooltip="Table View" />
                            </items>
                        </SegmentedButton>
                        <Button
                            id="assignRefreshBtnCard"
                            icon="sap-icon://refresh"
                            tooltip="{i18n>refreshData}"
                            press="onRefresh" />
                    </Toolbar>
                    <!-- Assignment Card Grid Container -->
                    <f:GridList
                        id="assignCardGrid"
                        mode="MultiSelect"
                        growing="true"
                        growingThreshold="30"
                        growingScrollToLoad="true"
                        noDataText="No assignments found. Adjust your filters."
                        items="{
                            path: '/TrainingAssignments',
                            sorter: { path: 'DueDate', descending: false }
                        }">
                        <f:customLayout>
                            <cssgrid:GridBoxLayout
                                boxMinWidth="20rem"
                                boxWidth="24rem" />
                        </f:customLayout>
                        <f:items>
                            <CustomListItem type="Active" press="onAssignCardPress" class="learningCard">
                                <HBox class="learningCardContent">
                                    <VBox class="learningCardBody" width="100%">
                                        <HBox alignItems="Center" class="learningCardTitleRow">
                                            <core:Icon
                                                src="{= ${Status} === 'Completed' ? 'sap-icon://accept' : ${Status} === 'In Progress' ? 'sap-icon://activity-2' : 'sap-icon://pending' }"
                                                size="1.25rem"
                                                color="{= ${Status} === 'Completed' ? '#107e3e' : ${Status} === 'In Progress' ? '#0854a0' : '#e76500' }"
                                                class="sapUiTinyMarginEnd" />
                                            <Text text="{Title}" class="learningCardTitle" maxLines="2" />
                                        </HBox>
                                        <HBox class="learningCardMeta sapUiTinyMarginTop" wrap="Wrap">
                                            <ObjectStatus
                                                text="{Status}"
                                                state="{= ${Status} === 'Completed' ? 'Success' : ${Status} === 'In Progress' ? 'Information' : 'Warning' }"
                                                icon="{= ${Status} === 'Completed' ? 'sap-icon://accept' : ${Status} === 'In Progress' ? 'sap-icon://activity-2' : 'sap-icon://pending' }"
                                                class="sapUiTinyMarginEnd"
                                                inverted="true" />
                                            <ObjectStatus text="{SapModule}" state="None" icon="sap-icon://tree" inverted="false" />
                                        </HBox>
                                        <HBox class="learningCardMeta sapUiTinyMarginTop" wrap="Wrap">
                                            <ObjectStatus
                                                text="{= 'Due: ' + ${DueDate} }"
                                                state="None"
                                                icon="sap-icon://date-time"
                                                class="sapUiTinyMarginEnd"
                                                inverted="false" />
                                            <ObjectStatus text="{UserName}" state="None" icon="sap-icon://person-placeholder" inverted="false" />
                                        </HBox>
                                    </VBox>
                                </HBox>
                                <Toolbar class="learningCardActions">
                                    <Button icon="sap-icon://begin" tooltip="Start Training" press="onAssignCardStart" type="Accept" />
                                    <Button icon="sap-icon://complete" tooltip="Mark Completed" press="onAssignCardComplete" type="Emphasized" />
                                    <ToolbarSpacer />
                                    <Button icon="sap-icon://inspect" tooltip="View Details" press="onAssignCardDetail" type="Transparent" />
                                    <Button icon="sap-icon://action" tooltip="Open Training URL" press="onAssignCardOpenUrl" type="Transparent" />
                                </Toolbar>
                            </CustomListItem>
                        </f:items>
                    </f:GridList>
                </VBox>
            </ScrollContainer>

            <!-- SmartTable for Assignments -->
            <smartTable:SmartTable
                id="assignSmartTable"
                entitySet="TrainingAssignments"
                smartFilterId="assignSmartFilterBar"
                tableType="ResponsiveTable"
                header="{i18n>trainingAssignments}"
                showRowCount="true"
                enableAutoBinding="true"
                showFullScreenButton="true"
                enableExport="true"
                useVariantManagement="false"
                useTablePersonalisation="true"
                persistencyKey="AssignmentsSmartTableV3"
                demandPopin="true"
                enableAutoColumnWidth="true"
                initialise="onSmartTableInit"
                initiallyVisibleFields="Title,Url,SapModule,UserId,UserName,Status,DueDate,CompletionDate"
                beforeRebindTable="onBeforeRebindTable"
                requestAtLeastFields="Url,Status"
                visible="{assignViewMode>/showTable}">

                <smartTable:noData>
                    <IllustratedMessage
                        id="assignmentsEmptyState"
                        illustrationType="sapIllus-NoTasks"
                        title="No Assignments Found"
                        description="You have no training assignments matching the current filters."
                        illustrationSize="Spot" />
                </smartTable:noData>

                <smartTable:customToolbar>
                    <OverflowToolbar id="assignTableToolbar">
                        <Button
                            id="startTrainingBtn"
                            text="{i18n>startTraining}"
                            icon="sap-icon://begin"
                            type="Accept"
                            press="onStartTraining" />
                        <Button
                            id="markCompletedBtn"
                            text="{i18n>markCompleted}"
                            icon="sap-icon://complete"
                            type="Emphasized"
                            press="onMarkCompletedBtn"
                            class="markCompletedToolbarBtn" />
                        <ToolbarSpacer id="assignToolbarSpacer" />
                        <SegmentedButton id="assignViewModeToggle2" selectedKey="{assignViewMode>/mode}" selectionChange="onAssignViewModeChange">
                            <items>
                                <SegmentedButtonItem id="assignViewModeCards2" key="cards" icon="sap-icon://grid" tooltip="Card View" />
                                <SegmentedButtonItem id="assignViewModeTable2" key="table" icon="sap-icon://table-view" tooltip="Table View" />
                            </items>
                        </SegmentedButton>
                        <Button
                            id="assignRefreshBtn"
                            icon="sap-icon://refresh"
                            tooltip="{i18n>refreshData}"
                            ariaLabelledBy="assignRefreshLabel"
                            press="onRefresh" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
