<mvc:View
    controllerName="z.sap.courses.controller.TrainingAssignmentsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">

    <Page
        id="assignmentsListPage"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press="onNavBack" type="Back" />
                    <Title text="Training Assignments" level="H2" />
                </contentLeft>
                <contentRight>
                    <Button
                        text="Back to Catalog"
                        icon="sap-icon://learning-assistant"
                        press="onNavBack" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- My Progress Analytics Panel -->
            <Panel
                id="myProgressPanel"
                expandable="true"
                expanded="true"
                headerText="My Learning Progress"
                class="sapUiSmallMarginBottom">
                <HBox justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin">
                    <VBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <ObjectNumber
                            id="myAssignedCount"
                            number="{assignAnalytics>/assigned}"
                            unit="Pending"
                            state="Warning" />
                        <Text text="To Start" class="sapUiTinyMarginTop" />
                    </VBox>
                    <VBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <ObjectNumber
                            id="myInProgressCount"
                            number="{assignAnalytics>/inProgress}"
                            unit="Learning"
                            state="Warning" />
                        <Text text="In Progress" class="sapUiTinyMarginTop" />
                    </VBox>
                    <VBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <ObjectNumber
                            id="myCompletedCount"
                            number="{assignAnalytics>/completed}"
                            unit="Done"
                            state="Success" />
                        <Text text="Completed" class="sapUiTinyMarginTop" />
                    </VBox>
                    <VBox alignItems="Center">
                        <ProgressIndicator
                            id="myProgress"
                            percentValue="{assignAnalytics>/completionPercent}"
                            displayValue="{assignAnalytics>/completionPercent}%"
                            state="{= ${assignAnalytics>/completionPercent} >= 80 ? 'Success' : ${assignAnalytics>/completionPercent} >= 50 ? 'Warning' : 'Error' }"
                            width="150px" />
                        <Text text="My Progress" class="sapUiTinyMarginTop" />
                    </VBox>
                </HBox>
            </Panel>

            <!-- SmartFilterBar for Assignments - expanded with filter boxes -->
            <smartFilterBar:SmartFilterBar
                id="assignSmartFilterBar"
                entitySet="TrainingAssignments"
                persistencyKey="AssignmentsSmartFilter"
                enableBasicSearch="true"
                showClearOnFB="true"
                filterBarExpanded="true"
                showFilterConfiguration="true" />

            <!-- SmartTable for Assignments -->
            <smartTable:SmartTable
                id="assignSmartTable"
                entitySet="TrainingAssignments"
                smartFilterId="assignSmartFilterBar"
                tableType="ResponsiveTable"
                header="Assignments"
                showRowCount="true"
                enableAutoBinding="true"
                showFullScreenButton="true"
                useExportToExcel="true"
                useVariantManagement="true"
                useTablePersonalisation="true"
                persistencyKey="AssignmentsSmartTable"
                demandPopin="true"
                enableAutoColumnWidth="true"
                initialise="onSmartTableInit">

                <smartTable:customToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="Refresh Data"
                            press="onRefresh" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
