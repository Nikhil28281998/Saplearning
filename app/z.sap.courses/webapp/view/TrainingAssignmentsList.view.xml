<mvc:View
    controllerName="z.sap.courses.controller.TrainingAssignmentsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">
    
    <Page
        id="assignmentsListPage"
        title="Training Assignments"
        showNavButton="true"
        navButtonPress="onNavBack">
        
        <headerContent>
            <Button
                icon="sap-icon://refresh"
                text="Refresh"
                press="onRefresh" />
        </headerContent>
        
        <content>
            <VBox class="sapUiSmallMargin">
                <Table
                    id="assignmentsTable"
                    inset="false"
                    items="{/TrainingAssignments}"
                    growing="true"
                    growingScrollToLoad="true">
                    
                    <columns>
                        <Column width="12em">
                            <Text text="Training" />
                        </Column>
                        <Column width="10em">
                            <Text text="User" />
                        </Column>
                        <Column width="8em">
                            <Text text="Status" />
                        </Column>
                        <Column width="10em" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Due Date" />
                        </Column>
                        <Column width="10em" minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Completed" />
                        </Column>
                    </columns>
                    
                    <items>
                        <ColumnListItem type="Active" press="onItemPress">
                            <cells>
                                <ObjectIdentifier
                                    title="{Title}"
                                    text="{TrainingId}" />
                                <VBox>
                                    <Text text="{UserId}" class="sapUiTinyMarginBottom" />
                                    <Text text="{UserName}" />
                                </VBox>
                                <ObjectStatus
                                    text="{Status}"
                                    state="{= ${Status} === 'Completed' ? 'Success' : ${Status} === 'In Progress' ? 'Warning' : 'Information' }" />
                                <Text text="{path: 'DueDate', type: 'sap.ui.model.type.DateTime', formatOptions: {style: 'medium'}}" />
                                <Text text="{path: 'CompletionDate', type: 'sap.ui.model.type.DateTime', formatOptions: {style: 'medium'}}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
