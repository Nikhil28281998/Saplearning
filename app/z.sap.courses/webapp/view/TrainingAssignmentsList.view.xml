<mvc:View
    controllerName="z.sap.courses.controller.TrainingAssignmentsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:mc="sap.suite.ui.microchart">

    <Page
        id="assignmentsListPage"
        showNavButton="false"
        enableScrolling="false"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content">

        <customHeader>
            <Bar id="assignHeaderBar">
                <contentLeft>
                    <Button id="navBackBtn" icon="sap-icon://nav-back" press="onNavBack" type="Back" tooltip="{i18n>backToCatalog}" />
                    <Title id="assignPageTitle" text="{i18n>trainingAssignments}" level="H2" />
                </contentLeft>
                <contentRight>
                    <!-- Role badge -->
                    <ObjectStatus
                        id="assignRoleBadge"
                        text="{user>/role}"
                        icon="sap-icon://role"
                        state="{= ${user>/role} === 'Admin' ? 'Success' : ${user>/role} === 'Manager' ? 'Warning' : 'Information' }"
                        class="sapUiSmallMarginEnd" />
                    <Button
                        id="backToCatalogBtn"
                        text="{i18n>backToCatalog}"
                        icon="sap-icon://learning-assistant"
                        press="onNavBack" />
                </contentRight>
            </Bar>
        </customHeader>

        <dependents>
            <core:InvisibleText id="assignmentsFilterLabel" text="{i18n>assignmentsFilterLabel}" />
            <core:InvisibleText id="assignmentsTableLabel" text="{i18n>assignmentsTableLabel}" />
            <core:InvisibleText id="assignRefreshLabel" text="{i18n>refreshData}" />
        </dependents>

        <content>
            <!-- ============================================================ -->
            <!-- MY PROGRESS – User's own assignment stats (always visible)   -->
            <!-- ============================================================ -->
            <Panel
                id="myProgressPanel"
                expandable="true"
                expanded="true"
                headerText="{i18n>myProgress}"
                class="sapUiSmallMarginBottom analyticsPanel">
                <HBox id="myProgressHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin analyticsContainer">
                    <VBox id="myAssignedBox" alignItems="Center" class="analyticsCard analyticsCardOrange">
                        <core:Icon id="myAssignedIcon" src="sap-icon://pending" size="1.5rem" color="#e76500" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="myAssignedCount"
                            number="{assignAnalytics>/assigned}"
                            state="Warning"
                            class="analyticsNumber" />
                        <Text id="myAssignedLabel" text="{i18n>toStart}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="myInProgressBox" alignItems="Center" class="analyticsCard analyticsCardTeal">
                        <core:Icon id="myInProgressIcon" src="sap-icon://activity-2" size="1.5rem" color="#0a6ed1" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="myInProgressCount"
                            number="{assignAnalytics>/inProgress}"
                            state="Information"
                            class="analyticsNumber" />
                        <Text id="myInProgressLabel" text="{i18n>inProgress}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="myCompletedBox" alignItems="Center" class="analyticsCard analyticsCardGreen">
                        <core:Icon id="myCompletedIcon" src="sap-icon://accept" size="1.5rem" color="#107e3e" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="myCompletedCount"
                            number="{assignAnalytics>/completed}"
                            state="Success"
                            class="analyticsNumber" />
                        <Text id="myCompletedLabel" text="{i18n>completed}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="myProgressBox" alignItems="Center" class="analyticsCard analyticsCardPurple">
                        <core:Icon id="myProgressIcon" src="sap-icon://target-group" size="1.5rem" color="#6c32a9" class="sapUiTinyMarginBottom" />
                        <mc:RadialMicroChart
                            id="myProgressRadial"
                            percentage="{assignAnalytics>/completionPercent}"
                            valueColor="{= ${assignAnalytics>/completionPercent} >= 80 ? 'Good' : ${assignAnalytics>/completionPercent} >= 50 ? 'Critical' : 'Error' }"
                            size="S" />
                        <Text id="myProgressLabel" text="{i18n>myAssignments}" class="analyticsLabel" />
                    </VBox>
                </HBox>
            </Panel>

            <!-- ============================================================ -->
            <!-- TEAM ANALYTICS – Manager/Admin only: org-wide completion     -->
            <!-- Shows how many users completed ALL their assignments          -->
            <!-- ============================================================ -->
            <Panel
                id="teamAnalyticsPanel"
                expandable="true"
                expanded="true"
                headerText="{i18n>teamAnalyticsHeader}"
                class="sapUiSmallMarginBottom analyticsPanel"
                visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }">
                <HBox id="teamAnalyticsHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin analyticsContainer">
                    <!-- Total Team Assignments -->
                    <VBox id="teamTotalBox" alignItems="Center" class="analyticsCard analyticsCardBlue">
                        <core:Icon id="teamTotalIcon" src="sap-icon://group" size="1.5rem" color="#0854a0" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="teamTotalCount"
                            number="{teamAnalytics>/totalAssignments}"
                            state="Information"
                            class="analyticsNumber" />
                        <Text id="teamTotalLabel" text="{i18n>teamTotalAssignments}" class="analyticsLabel" />
                    </VBox>
                    <!-- Team Assigned (pending) -->
                    <VBox id="teamAssignedBox" alignItems="Center" class="analyticsCard analyticsCardOrange">
                        <core:Icon id="teamAssignedIcon" src="sap-icon://pending" size="1.5rem" color="#e76500" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="teamAssignedCount"
                            number="{teamAnalytics>/assigned}"
                            state="Warning"
                            class="analyticsNumber" />
                        <Text id="teamAssignedLabel" text="{i18n>teamPending}" class="analyticsLabel" />
                    </VBox>
                    <!-- Team In Progress -->
                    <VBox id="teamInProgressBox" alignItems="Center" class="analyticsCard analyticsCardTeal">
                        <core:Icon id="teamInProgressIcon" src="sap-icon://activity-2" size="1.5rem" color="#0a6ed1" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="teamInProgressCount"
                            number="{teamAnalytics>/inProgress}"
                            state="Information"
                            class="analyticsNumber" />
                        <Text id="teamInProgressLabel" text="{i18n>teamInProgress}" class="analyticsLabel" />
                    </VBox>
                    <!-- Team Completed -->
                    <VBox id="teamCompletedBox" alignItems="Center" class="analyticsCard analyticsCardGreen">
                        <core:Icon id="teamCompletedIcon" src="sap-icon://accept" size="1.5rem" color="#107e3e" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="teamCompletedCount"
                            number="{teamAnalytics>/completed}"
                            state="Success"
                            class="analyticsNumber" />
                        <Text id="teamCompletedLabel" text="{i18n>teamCompleted}" class="analyticsLabel" />
                    </VBox>
                    <!-- Team Completion Rate -->
                    <VBox id="teamCompletionBox" alignItems="Center" class="analyticsCard analyticsCardPurple">
                        <core:Icon id="teamCompletionIcon" src="sap-icon://performance" size="1.5rem" color="#6c32a9" class="sapUiTinyMarginBottom" />
                        <mc:RadialMicroChart
                            id="teamCompletionRadial"
                            percentage="{teamAnalytics>/completionPercent}"
                            valueColor="{= ${teamAnalytics>/completionPercent} >= 80 ? 'Good' : ${teamAnalytics>/completionPercent} >= 50 ? 'Critical' : 'Error' }"
                            size="S" />
                        <Text id="teamCompletionLabel" text="{i18n>teamCompletionRate}" class="analyticsLabel" />
                    </VBox>
                </HBox>
                <!-- Team Status Distribution Chart (Manager/Admin) -->
                <HBox id="teamChartsHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin">
                    <!-- Status Distribution -->
                    <VBox id="teamStatusChartBox" class="analyticsCard analyticsCardBlue chartCard">
                        <HBox id="teamStatusHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="teamStatusIcon" src="sap-icon://horizontal-bar-chart" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                            <Text id="teamStatusTitle" text="{i18n>teamStatusDistribution}" class="chartTitle" />
                        </HBox>
                        <mc:StackedBarMicroChart id="teamStatusBar" size="L" width="100%">
                            <mc:bars>
                                <mc:StackedBarMicroChartBar id="teamBarAssigned" value="{teamAnalytics>/assigned}" valueColor="Critical" displayValue="{teamAnalytics>/assigned}" />
                                <mc:StackedBarMicroChartBar id="teamBarInProgress" value="{teamAnalytics>/inProgress}" valueColor="Neutral" displayValue="{teamAnalytics>/inProgress}" />
                                <mc:StackedBarMicroChartBar id="teamBarCompleted" value="{teamAnalytics>/completed}" valueColor="Good" displayValue="{teamAnalytics>/completed}" />
                            </mc:bars>
                        </mc:StackedBarMicroChart>
                        <HBox id="teamLegendBox" justifyContent="SpaceBetween" class="sapUiTinyMarginTop chartLegendRow">
                            <HBox id="teamLegendPending" alignItems="Center">
                                <core:Icon id="teamLegDotP" src="sap-icon://circle-task-2" size="0.625rem" color="#bb0000" class="sapUiTinyMarginEnd" />
                                <Text id="teamLegTextP" text="{i18n>pending}" class="chartLegendText" />
                            </HBox>
                            <HBox id="teamLegendIP" alignItems="Center">
                                <core:Icon id="teamLegDotIP" src="sap-icon://circle-task-2" size="0.625rem" color="#5b738b" class="sapUiTinyMarginEnd" />
                                <Text id="teamLegTextIP" text="{i18n>learning}" class="chartLegendText" />
                            </HBox>
                            <HBox id="teamLegendDone" alignItems="Center">
                                <core:Icon id="teamLegDotD" src="sap-icon://circle-task-2" size="0.625rem" color="#107e3e" class="sapUiTinyMarginEnd" />
                                <Text id="teamLegTextD" text="{i18n>done}" class="chartLegendText" />
                            </HBox>
                        </HBox>
                    </VBox>
                    <!-- User Completion Breakdown: which users have completed all assignments -->
                    <VBox id="teamUserChartBox" class="analyticsCard analyticsCardTeal chartCard">
                        <HBox id="teamUserChartHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="teamUserChartIcon" src="sap-icon://customer" size="1rem" color="#0a6ed1" class="sapUiTinyMarginEnd" />
                            <Text id="teamUserChartTitle" text="{i18n>teamUserProgress}" class="chartTitle" />
                        </HBox>
                        <VBox id="teamUserListContainer" />
                    </VBox>
                </HBox>
            </Panel>

            <!-- SmartFilterBar for Assignments -->
            <smartFilterBar:SmartFilterBar
                id="assignSmartFilterBar"
                entitySet="TrainingAssignments"
                persistencyKey="AssignmentsSmartFilter"
                ariaLabelledBy="assignmentsFilterLabel"
                enableBasicSearch="true"
                showClearOnFB="false"
                showRestoreOnFB="false"
                showGoOnFB="true"
                filterBarExpanded="true"
                showFilterConfiguration="true" />

            <!-- SmartTable for Assignments -->
            <smartTable:SmartTable
                id="assignSmartTable"
                entitySet="TrainingAssignments"
                smartFilterId="assignSmartFilterBar"
                tableType="ResponsiveTable"
                header="{i18n>trainingAssignments}"
                showRowCount="true"
                enableAutoBinding="true"
                showFullScreenButton="true"
                enableExport="true"
                useVariantManagement="false"
                useTablePersonalisation="true"
                persistencyKey="AssignmentsSmartTableV3"
                demandPopin="true"
                enableAutoColumnWidth="true"
                initialise="onSmartTableInit"
                initiallyVisibleFields="Title,Url,SapModule,UserId,UserName,Status,DueDate,CompletionDate"
                beforeRebindTable="onBeforeRebindTable"
                requestAtLeastFields="Url,Status">

                <smartTable:customToolbar>
                    <OverflowToolbar id="assignTableToolbar">
                        <Button
                            id="markCompletedBtn"
                            text="{i18n>markCompleted}"
                            icon="sap-icon://complete"
                            type="Emphasized"
                            press="onMarkCompletedBtn"
                            class="markCompletedToolbarBtn" />
                        <ToolbarSpacer id="assignToolbarSpacer" />
                        <Button
                            id="assignRefreshBtn"
                            icon="sap-icon://refresh"
                            tooltip="{i18n>refreshData}"
                            ariaLabelledBy="assignRefreshLabel"
                            press="onRefresh" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
