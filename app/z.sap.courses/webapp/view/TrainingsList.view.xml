<mvc:View
    controllerName="z.sap.courses.controller.TrainingsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:filterBar="sap.ui.comp.filterbar"
    xmlns:f="sap.f"
    xmlns:cssgrid="sap.ui.layout.cssgrid">

    <Page
        id="trainingsListPage"
        showNavButton="false"
        enableScrolling="false"
        class="trainingsPage sapUiResponsivePadding--header sapUiResponsivePadding--content">

        <!-- Page Header: Title + Role badge + My Assignments -->
        <customHeader>
            <Bar id="headerBar">
                <contentLeft>
                    <Title id="headerTitle" text="{i18n>appTitle}" level="H3" />
                </contentLeft>
                <contentRight>
                    <!-- Role badge: shows the PFCG-detected role (read-only) -->
                    <ObjectStatus
                        id="roleBadge"
                        text="{user>/role}"
                        icon="sap-icon://role"
                        state="{= ${user>/role} === 'Admin' ? 'Success' : ${user>/role} === 'Manager' ? 'Warning' : 'Information' }"
                        class="sapUiSmallMarginEnd" />
                    <Button
                        id="myAssignmentsBtn"
                        text="{i18n>myAssignments}"
                        icon="sap-icon://task"
                        press="onViewAssignments"
                        type="Emphasized" />
                    <Button
                        id="tutorialBtn"
                        icon="sap-icon://sys-help"
                        tooltip="How to use this app"
                        press="onOpenTutorial"
                        type="Transparent" />
                    <Button
                        id="messagePopoverBtn"
                        icon="sap-icon://message-popup"
                        text="{= ${message>/}.length > 0 ? ${message>/}.length : '' }"
                        type="{= ${message>/}.length > 0 ? 'Negative' : 'Default' }"
                        press="onMessagePopoverPress"
                        visible="{= ${message>/}.length > 0 }" />
                </contentRight>
            </Bar>
        </customHeader>

        <dependents>
            <core:InvisibleText id="trainingsFilterLabel" text="{i18n>trainingsFilterLabel}" />
            <core:InvisibleText id="trainingsTableLabel" text="{i18n>trainingsTableLabel}" />
            <core:InvisibleText id="refreshButtonLabel" text="{i18n>refreshData}" />
        </dependents>

        <content>
            <!-- ============================================================ -->
            <!-- TEAM ANALYTICS – Manager/Admin only: org-wide completion     -->
            <!-- ============================================================ -->
            <Panel
                id="teamAnalyticsPanel"
                expandable="true"
                expanded="true"
                headerText="{i18n>teamAnalyticsHeader}"
                class="sapUiSmallMarginBottom analyticsPanel"
                visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }">

                <!-- 5 KPI Cards Row -->
                <VBox id="teamAnalyticsHBox" class="analyticsContainer">
                    <VBox id="teamTotalBox" alignItems="Center" class="analyticsCard teamKpiCard analyticsCardBlue" tooltip="{i18n>clickToFilter}">
                        <core:Icon id="teamTotalIcon" src="sap-icon://group" size="2rem" color="#0854a0" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamTotalCount" number="{teamAnalytics>/totalAssignments}" state="Information" class="analyticsNumber" />
                        <Text id="teamTotalLabel" text="{i18n>teamTotalAssignments}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="teamAssignedBox" alignItems="Center" class="analyticsCard teamKpiCard analyticsCardOrange" tooltip="{i18n>clickToFilter}">
                        <core:Icon id="teamAssignedIcon" src="sap-icon://pending" size="2rem" color="#e76500" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamAssignedCount" number="{teamAnalytics>/assigned}" state="Warning" class="analyticsNumber" />
                        <Text id="teamAssignedLabel" text="{i18n>teamPending}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="teamInProgressBox" alignItems="Center" class="analyticsCard teamKpiCard analyticsCardBlue" tooltip="{i18n>clickToFilter}">
                        <core:Icon id="teamInProgressIcon" src="sap-icon://activity-2" size="2rem" color="#0854a0" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamInProgressCount" number="{teamAnalytics>/inProgress}" state="Information" class="analyticsNumber" />
                        <Text id="teamInProgressLabel" text="{i18n>teamInProgress}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="teamOverdueBox" alignItems="Center" class="analyticsCard teamKpiCard analyticsCardRed" tooltip="{i18n>clickToFilter}">
                        <core:Icon id="teamOverdueIcon" src="sap-icon://alert" size="2rem" color="#bb0000" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamOverdueCount" number="{teamAnalytics>/overdue}" state="Error" class="analyticsNumber" />
                        <Text id="teamOverdueLabel" text="{i18n>teamOverdue}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="teamCompletedBox" alignItems="Center" class="analyticsCard teamKpiCard analyticsCardGreen" tooltip="{i18n>clickToFilter}">
                        <core:Icon id="teamCompletedIcon" src="sap-icon://accept" size="2rem" color="#107e3e" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamCompletedCount" number="{teamAnalytics>/completed}" state="Success" class="analyticsNumber" />
                        <Text id="teamCompletedLabel" text="{i18n>teamCompleted}" class="analyticsLabel" />
                    </VBox>
                </VBox>

                <!-- Full-Width Completion Progress Bar -->
                <VBox id="teamCompletionBarCard" class="completionBarCard sapUiSmallMargin">
                    <HBox id="teamCompletionBarHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                        <core:Icon id="teamCompletionBarIcon" src="sap-icon://performance" size="1.25rem" color="#6c32a9" class="sapUiTinyMarginEnd" />
                        <Title id="teamCompletionBarTitle" text="{i18n>teamCompletionRate}" level="H5" />
                        <Text id="teamCompletionPct" text="{= ${teamAnalytics>/completionPercent} + '%' }" class="sapUiSmallMarginBegin completionPctLabel" />
                    </HBox>
                    <ProgressIndicator
                        id="teamCompletionBar"
                        percentValue="{teamAnalytics>/completionPercent}"
                        displayValue="{= ${teamAnalytics>/completionPercent} + '%' }"
                        state="{= ${teamAnalytics>/completionPercent} >= 80 ? 'Success' : ${teamAnalytics>/completionPercent} >= 50 ? 'Warning' : 'Information' }"
                        showValue="true"
                        height="2.5rem"
                        class="teamCompletionProgressBar" />
                    <Text id="teamCompletionSubtitle"
                        text="{= 'Completed: ' + ${teamAnalytics>/completed} + '  |  Remaining: ' + (${teamAnalytics>/totalAssignments} - ${teamAnalytics>/completed}) }"
                        class="motivationalText sapUiTinyMarginTop" />
                </VBox>

                <!-- Charts 3-Column Grid: Status Distribution + Top Modules + User Progress -->
                <VBox id="teamChartsHBox" class="sapUiSmallMargin chartsRow">
                    <VBox id="teamStatusChartBox" class="analyticsCard analyticsCardBlue chartCard">
                        <HBox id="teamStatusHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="teamStatusIcon" src="sap-icon://horizontal-bar-chart" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                            <Text id="teamStatusTitle" text="{i18n>teamStatusDistribution}" class="chartTitle" />
                        </HBox>
                        <VBox id="teamStatusChartContent" class="sapUiTinyMarginTop">
                            <HBox id="teamPendingRow" alignItems="Center" class="sapUiTinyMarginBottom">
                                <core:Icon id="teamPendingDot" src="sap-icon://pending" size="1rem" color="#e76500" class="sapUiTinyMarginEnd" />
                                <Text id="teamPendingLbl" text="{i18n>pending}" class="sapUiTinyMarginEnd chartLegendText" width="5rem" />
                                <ProgressIndicator
                                    id="teamPendingBar"
                                    percentValue="{= ${teamAnalytics>/totalAssignments} > 0 ? (${teamAnalytics>/assigned} / ${teamAnalytics>/totalAssignments} * 100) : 0 }"
                                    displayValue="{teamAnalytics>/assigned}"
                                    state="Warning"
                                    showValue="true"
                                    width="100%"
                                    height="1.75rem" />
                            </HBox>
                            <HBox id="teamInProgressRow" alignItems="Center" class="sapUiTinyMarginBottom">
                                <core:Icon id="teamInProgressDot" src="sap-icon://activity-2" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                                <Text id="teamInProgressLbl" text="{i18n>inProgress}" class="sapUiTinyMarginEnd chartLegendText" width="5rem" />
                                <ProgressIndicator
                                    id="teamInProgressBar"
                                    percentValue="{= ${teamAnalytics>/totalAssignments} > 0 ? (${teamAnalytics>/inProgress} / ${teamAnalytics>/totalAssignments} * 100) : 0 }"
                                    displayValue="{teamAnalytics>/inProgress}"
                                    state="Information"
                                    showValue="true"
                                    width="100%"
                                    height="1.75rem" />
                            </HBox>
                            <HBox id="teamOverdueRow" alignItems="Center" class="sapUiTinyMarginBottom">
                                <core:Icon id="teamOverdueDot" src="sap-icon://alert" size="1rem" color="#bb0000" class="sapUiTinyMarginEnd" />
                                <Text id="teamOverdueLbl" text="{i18n>overdue}" class="sapUiTinyMarginEnd chartLegendText" width="5rem" />
                                <ProgressIndicator
                                    id="teamOverdueBar"
                                    percentValue="{= ${teamAnalytics>/totalAssignments} > 0 ? (${teamAnalytics>/overdue} / ${teamAnalytics>/totalAssignments} * 100) : 0 }"
                                    displayValue="{teamAnalytics>/overdue}"
                                    state="Error"
                                    showValue="true"
                                    width="100%"
                                    height="1.75rem" />
                            </HBox>
                            <HBox id="teamCompletedRow" alignItems="Center">
                                <core:Icon id="teamCompletedDot" src="sap-icon://accept" size="1rem" color="#107e3e" class="sapUiTinyMarginEnd" />
                                <Text id="teamCompletedLbl" text="{i18n>done}" class="sapUiTinyMarginEnd chartLegendText" width="5rem" />
                                <ProgressIndicator
                                    id="teamCompletedBar"
                                    percentValue="{= ${teamAnalytics>/totalAssignments} > 0 ? (${teamAnalytics>/completed} / ${teamAnalytics>/totalAssignments} * 100) : 0 }"
                                    displayValue="{teamAnalytics>/completed}"
                                    state="Success"
                                    showValue="true"
                                    width="100%"
                                    height="1.75rem" />
                            </HBox>
                        </VBox>
                    </VBox>
                    <!-- Top Modules Chart -->
                    <VBox id="moduleChartBox" class="analyticsCard analyticsCardBlue chartCard">
                        <HBox id="moduleChartHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="moduleChartIcon" src="sap-icon://bar-chart" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                            <Text id="moduleChartTitle" text="{i18n>topModules}" class="chartTitle" />
                        </HBox>
                        <VBox id="moduleChartContainer"
                              items="{path: 'analyticsModel>/moduleDistribution'}"
                              visible="{= ${analyticsModel>/moduleDistribution}.length > 0 }">
                            <items>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom moduleBarRow">
                                    <Text text="{analyticsModel>label}" class="moduleBarLabel sapUiTinyMarginEnd" width="8rem" wrapping="false" />
                                    <ProgressIndicator
                                        percentValue="{analyticsModel>percentOfMax}"
                                        displayValue="{analyticsModel>displayValue}"
                                        state="Information"
                                        showValue="true"
                                        width="100%"
                                        height="1.75rem"
                                        class="moduleProgressBar" />
                                </HBox>
                            </items>
                        </VBox>
                        <Text id="moduleChartNoData"
                              text="{i18n>noModuleData}"
                              visible="{= !${analyticsModel>/moduleDistribution} || ${analyticsModel>/moduleDistribution}.length === 0 }" />
                    </VBox>
                    <!-- User Progress Chart -->
                    <VBox id="teamMembersCard" class="analyticsCard analyticsCardBlue chartCard">
                        <HBox id="teamMembersHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="teamMembersIcon" src="sap-icon://customer" size="1rem" color="#0a6ed1" class="sapUiTinyMarginEnd" />
                            <Text id="teamMembersTitle" text="{i18n>teamUserProgress}" class="chartTitle" />
                        </HBox>
                        <List id="teamUserList"
                              items="{path: 'teamAnalytics>/userBreakdown', length: 10}"
                              showNoData="true"
                              noDataText="{i18n>noTeamMembers}"
                              showSeparators="None">
                            <items>
                                <core:Fragment fragmentName="z.sap.courses.fragments.TeamUserRow" type="XML" />
                            </items>
                        </List>
                    </VBox>
                </VBox>
            </Panel>

            <!-- SmartFilterBar: Go + Adapt Filters with explicit Role/Module dropdown filters -->
            <smartFilterBar:SmartFilterBar
                id="smartFilterBar"
                entitySet="Trainings"
                persistencyKey="TrainingsSmartFilter"
                ariaLabelledBy="trainingsFilterLabel"
                enableBasicSearch="true"
                showClearOnFB="false"
                showRestoreOnFB="false"
                showGoOnFB="true"
                filterBarExpanded="true"
                showFilterConfiguration="true"
                useDateRangeType="true">
                <smartFilterBar:controlConfiguration>
                    <smartFilterBar:ControlConfiguration id="ccRole" key="Role" filterType="single" />
                    <smartFilterBar:ControlConfiguration id="ccTopic" key="Topic" filterType="single" />
                    <smartFilterBar:ControlConfiguration id="ccSapModule" key="SapModule" filterType="single" />
                </smartFilterBar:controlConfiguration>
                <smartFilterBar:filterGroupItems>
                    <filterBar:FilterGroupItem
                        id="fgiRole"
                        name="Role"
                        label="{i18n>roleLabel}"
                        groupName="_BASIC"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <Select id="filterRole" forceSelection="false" selectedKey="" change="onRoleFilterChange"
                                items="{filterData>/roles}">
                                <core:Item id="roleItem" key="{filterData>key}" text="{filterData>text}" />
                            </Select>
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                    <filterBar:FilterGroupItem
                        id="fgiTopic"
                        name="Topic"
                        label="{i18n>topicLabel}"
                        groupName="_BASIC"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <Select id="filterTopic" forceSelection="false" selectedKey="" change="onTopicFilterChange"
                                items="{filterData>/topics}">
                                <core:Item id="topicItem" key="{filterData>key}" text="{filterData>text}" />
                            </Select>
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                    <filterBar:FilterGroupItem
                        id="fgiModule"
                        name="SapModule"
                        label="{i18n>moduleLabel}"
                        groupName="_BASIC"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <Select id="filterModule" forceSelection="false" selectedKey="" change="onModuleFilterChange"
                                items="{filterData>/modules}">
                                <core:Item id="moduleItem" key="{filterData>key}" text="{filterData>text}" />
                            </Select>
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                </smartFilterBar:filterGroupItems>
            </smartFilterBar:SmartFilterBar>

            <!-- ====== CARD GRID VIEW (Learning Hub style) ====== -->
            <ScrollContainer
                id="cardScrollContainer"
                height="100%"
                width="100%"
                vertical="true"
                horizontal="false"
                visible="{viewMode>/showCards}">
                <VBox id="cardGridWrapper" class="cardGridWrapper">
                    <!-- Card count + View toggle toolbar -->
                    <Toolbar id="cardToolbar" class="sapUiSmallMarginBottom">
                        <Title id="cardCountTitle" text="{= 'Learning Content (' + ${viewMode>/cardCount} + ')' }" level="H5" />
                        <ToolbarSpacer id="cardToolbarSpacer1" />
                        <SegmentedButton id="viewModeToggle" selectedKey="{viewMode>/mode}" selectionChange="onViewModeChange">
                            <items>
                                <SegmentedButtonItem id="viewModeCards" key="cards" icon="sap-icon://grid" tooltip="Card View" />
                                <SegmentedButtonItem id="viewModeTable" key="table" icon="sap-icon://table-view" tooltip="Table View" />
                            </items>
                        </SegmentedButton>
                        <Button
                            id="refreshButtonCard"
                            icon="sap-icon://refresh"
                            tooltip="{i18n>refreshData}"
                            press="onRefresh" />
                    </Toolbar>
                    <!-- Card Grid Container -->
                    <f:GridList
                        id="cardGrid"
                        mode="MultiSelect"
                        growing="true"
                        growingThreshold="30"
                        growingScrollToLoad="true"
                        noDataText="No learning content found. Adjust your filters."
                        items="{
                            path: '/Trainings',
                            sorter: { path: 'Title', descending: false }
                        }">
                        <f:customLayout>
                            <cssgrid:GridBoxLayout
                                boxMinWidth="20rem"
                                boxWidth="24rem" />
                        </f:customLayout>
                        <f:items>
                            <CustomListItem type="Active" press="onCardPress" class="learningCard">
                                <HBox class="learningCardContent">
                                    <VBox class="learningCardBody" width="100%">
                                        <HBox alignItems="Center" class="learningCardTitleRow">
                                            <core:Icon
                                                src="{= ${SapModule} === 'BTP' ? 'sap-icon://cloud' : ${SapModule} === 'Integration' ? 'sap-icon://connected' : ${SapModule} === 'MM' ? 'sap-icon://shipping-status' : 'sap-icon://capital-projects' }"
                                                size="1.25rem"
                                                color="{= ${SapModule} === 'BTP' ? '#0854a0' : ${SapModule} === 'Integration' ? '#1a6b3c' : ${SapModule} === 'MM' ? '#945200' : '#0070f2' }"
                                                class="sapUiTinyMarginEnd" />
                                            <Text text="{Title}" class="learningCardTitle" maxLines="2" />
                                        </HBox>
                                        <Text text="{Description}" class="learningCardDesc" maxLines="2" />
                                        <HBox class="learningCardMeta sapUiTinyMarginTop" wrap="Wrap">
                                            <ObjectStatus text="{Topic}" state="Information" icon="sap-icon://tag" class="sapUiTinyMarginEnd" inverted="false" />
                                            <ObjectStatus text="{SapModule}" state="None" icon="sap-icon://tree" inverted="false" />
                                        </HBox>
                                    </VBox>
                                    <VBox class="learningCardActions" alignItems="Center" justifyContent="Center">
                                        <Button
                                            icon="sap-icon://inspect"
                                            type="Transparent"
                                            tooltip="View Details"
                                            press="onCardDetailPress" />
                                        <Button
                                            icon="sap-icon://open-command-field"
                                            type="Transparent"
                                            tooltip="Open Exercise"
                                            press="onCardOpenUrl" />
                                    </VBox>
                                </HBox>
                            </CustomListItem>
                        </f:items>
                    </f:GridList>
                </VBox>
            </ScrollContainer>

            <!-- SmartTable: auto-generates columns from annotations
                 Provides: Variant Management, Column Settings, Export to Excel,
                 auto-column width, responsive popin, row count, full screen -->
            <smartTable:SmartTable
                id="smartTable"
                entitySet="Trainings"
                smartFilterId="smartFilterBar"
                tableType="Table"
                header="{i18n>columnTraining}"
                showRowCount="true"
                enableAutoBinding="true"
                showFullScreenButton="true"
                enableExport="true"
                useVariantManagement="false"
                useTablePersonalisation="true"
                persistencyKey="TrainingsSmartTableV3"
                initialise="onSmartTableInit"
                beforeRebindTable="onBeforeRebindTable"
                fitContainer="true"
                enableAutoColumnWidth="true"
                ignoredFields="Id"
                initiallyVisibleFields="Title,Role,Topic,SapModule,Description,LastUpdated,Url,SapHelpLink"
                requestAtLeastFields="Id,Url,SapHelpLink,Role,Topic"
                visible="{viewMode>/showTable}">

                <smartTable:noData>
                    <IllustratedMessage
                        id="trainingsEmptyState"
                        illustrationType="sapIllus-NoEntries"
                        title="{i18n>noTrainingsFoundTitle}"
                        description="{i18n>noTrainingsFoundDesc}"
                        illustrationSize="Spot" />
                </smartTable:noData>

                <!-- Custom buttons added to SmartTable toolbar alongside auto-generated ones -->
                <smartTable:customToolbar>
                    <OverflowToolbar id="tableToolbar">
                        <Button
                            id="createTrainingBtn"
                            icon="sap-icon://add"
                            text="{i18n>createBtn}"
                            type="Emphasized"
                            press="onCreateTraining"
                            visible="{= ${user>/role} === 'Admin' }" />
                        <Button
                            id="deleteTrainingBtn"
                            icon="sap-icon://delete"
                            text="{i18n>deleteBtn}"
                            type="Reject"
                            press="onDeleteTraining"
                            visible="{= ${user>/role} === 'Admin' }" />
                        <Button
                            id="editTrainingBtn"
                            icon="sap-icon://edit"
                            text="{i18n>editBtn}"
                            type="Default"
                            press="onEditTraining"
                            visible="{= ${user>/role} === 'Admin' }" />
                        <ToolbarSpacer id="toolbarSpacer" />
                        <Button
                            id="detailsButton"
                            icon="sap-icon://detail-view"
                            text="{i18n>viewDetails}"
                            press="onViewDetails" />
                        <Button
                            id="assignButton"
                            icon="sap-icon://person-placeholder"
                            text="{i18n>assignTraining}"
                            type="Attention"
                            press="onAssignTraining"
                            visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }" />
                        <Button
                            id="enrollMeBtn"
                            icon="sap-icon://add-coursebook"
                            text="{i18n>enrollMe}"
                            type="Ghost"
                            press="onEnrollMe"
                            visible="{= ${user>/role} === 'User' }" />
                        <Button
                            id="refreshButton"
                            icon="sap-icon://refresh"
                            tooltip="{i18n>refreshData}"
                            ariaLabelledBy="refreshButtonLabel"
                            press="onRefresh" />
                        <SegmentedButton id="viewModeToggleTable" selectedKey="{viewMode>/mode}" selectionChange="onViewModeChange">
                            <items>
                                <SegmentedButtonItem id="viewModeCardsTable" key="cards" icon="sap-icon://grid" tooltip="Card View" />
                                <SegmentedButtonItem id="viewModeTableTable" key="table" icon="sap-icon://table-view" tooltip="Table View" />
                            </items>
                        </SegmentedButton>
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
