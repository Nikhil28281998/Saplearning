<mvc:View
    controllerName="z.sap.courses.controller.TrainingsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">

    <Page
        id="trainingsListPage"
        showNavButton="false"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content">

        <!-- Page Header: Title + Role badge + My Assignments -->
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="SAP Learning - Training Catalog" level="H2" />
                </contentLeft>
                <contentRight>
                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <core:Icon src="sap-icon://role" class="sapUiTinyMarginEnd" />
                        <ObjectStatus
                            text="{user>/role}"
                            state="{= ${user>/role} === 'Admin' ? 'Success' : ${user>/role} === 'Manager' ? 'Warning' : 'Information' }" />
                    </HBox>
                    <Button
                        text="My Assignments"
                        icon="sap-icon://task"
                        press="onViewAssignments"
                        type="Emphasized" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- Analytics Panel for all users -->
            <Panel
                id="analyticsPanel"
                expandable="true"
                expanded="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }"
                headerText="Training Analytics"
                class="sapUiSmallMarginBottom">
                <HBox justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin">
                    <VBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <ObjectNumber
                            id="totalTrainingsCount"
                            number="{analyticsModel>/totalTrainings}"
                            unit="Trainings"
                            state="Information" />
                        <Text text="Total Catalog" class="sapUiTinyMarginTop" />
                    </VBox>
                    <VBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <ObjectNumber
                            id="assignedCount"
                            number="{analyticsModel>/assigned}"
                            unit="Assigned"
                            state="Warning" />
                        <Text text="Pending" class="sapUiTinyMarginTop" />
                    </VBox>
                    <VBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <ObjectNumber
                            id="inProgressCount"
                            number="{analyticsModel>/inProgress}"
                            unit="In Progress"
                            state="Warning" />
                        <Text text="Learning" class="sapUiTinyMarginTop" />
                    </VBox>
                    <VBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <ObjectNumber
                            id="completedCount"
                            number="{analyticsModel>/completed}"
                            unit="Completed"
                            state="Success" />
                        <Text text="Done" class="sapUiTinyMarginTop" />
                    </VBox>
                    <VBox alignItems="Center">
                        <ProgressIndicator
                            id="completionProgress"
                            percentValue="{analyticsModel>/completionPercent}"
                            displayValue="{analyticsModel>/completionPercent}%"
                            state="{= ${analyticsModel>/completionPercent} >= 80 ? 'Success' : ${analyticsModel>/completionPercent} >= 50 ? 'Warning' : 'Error' }"
                            width="150px" />
                        <Text text="Completion Rate" class="sapUiTinyMarginTop" />
                    </VBox>
                </HBox>
            </Panel>

            <!-- SmartFilterBar: filter boxes visible by default -->
            <smartFilterBar:SmartFilterBar
                id="smartFilterBar"
                entitySet="Trainings"
                persistencyKey="TrainingsSmartFilter"
                enableBasicSearch="true"
                showClearOnFB="true"
                filterBarExpanded="true"
                showFilterConfiguration="true" />

            <!-- SmartTable: auto-generates columns from annotations
                 Provides: Variant Management, Column Settings, Export to Excel,
                 auto-column width, responsive popin, row count, full screen -->
            <smartTable:SmartTable
                id="smartTable"
                entitySet="Trainings"
                smartFilterId="smartFilterBar"
                tableType="ResponsiveTable"
                header="Trainings"
                showRowCount="true"
                enableAutoBinding="true"
                showFullScreenButton="true"
                useExportToExcel="true"
                useVariantManagement="true"
                useTablePersonalisation="true"
                persistencyKey="TrainingsSmartTable"
                demandPopin="true"
                enableAutoColumnWidth="true"
                initialise="onSmartTableInit"
                beforeRebindTable="onBeforeRebindTable">

                <!-- Custom buttons added to SmartTable toolbar alongside auto-generated ones -->
                <smartTable:customToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            id="assignButton"
                            icon="sap-icon://add"
                            text="Assign Training"
                            type="Emphasized"
                            press="onAssignTraining"
                            visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }" />
                        <Button
                            icon="sap-icon://refresh"
                            tooltip="Refresh Data"
                            press="onRefresh" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
