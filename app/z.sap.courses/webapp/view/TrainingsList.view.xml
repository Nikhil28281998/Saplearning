<mvc:View
    controllerName="z.sap.courses.controller.TrainingsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:filterBar="sap.ui.comp.filterbar"
    xmlns:mc="sap.suite.ui.microchart">

    <Page
        id="trainingsListPage"
        showNavButton="false"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content">

        <!-- Page Header: Title + Role badge + My Assignments -->
        <customHeader>
            <Bar id="headerBar">
                <contentLeft>
                    <Title id="pageTitle" text="SAP Learning - Training Catalog" level="H2" />
                </contentLeft>
                <contentRight>
                    <HBox id="roleBox" alignItems="Center" class="sapUiSmallMarginEnd">
                        <core:Icon id="roleIcon" src="sap-icon://role" class="sapUiTinyMarginEnd" />
                        <ObjectStatus
                            id="roleStatus"
                            text="{user>/role}"
                            state="{= ${user>/role} === 'Admin' ? 'Success' : ${user>/role} === 'Manager' ? 'Warning' : 'Information' }" />
                    </HBox>
                    <Button
                        id="myAssignmentsBtn"
                        text="My Assignments"
                        icon="sap-icon://task"
                        press="onViewAssignments"
                        type="Emphasized" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- Analytics Dashboard - Modern Tile Cards -->
            <Panel
                id="analyticsPanel"
                expandable="true"
                expanded="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }"
                headerText="Training Analytics"
                class="sapUiSmallMarginBottom">
                <HBox id="analyticsHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin analyticsContainer">
                    <!-- Total Trainings Card -->
                    <VBox id="totalBox" alignItems="Center" class="analyticsCard analyticsCardBlue">
                        <core:Icon id="totalIcon" src="sap-icon://course-book" size="1.5rem" color="#0854a0" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="totalTrainingsCount"
                            number="{analyticsModel>/totalTrainings}"
                            state="Information"
                            class="analyticsNumber" />
                        <Text id="totalLabel" text="Total Catalog" class="analyticsLabel" />
                    </VBox>
                    <!-- Assigned Card (Manager/Admin: org-wide | User: my assignments) -->
                    <VBox id="assignedBox" alignItems="Center" class="analyticsCard analyticsCardOrange">
                        <core:Icon id="assignedIcon" src="sap-icon://pending" size="1.5rem" color="#e76500" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="assignedCount"
                            number="{analyticsModel>/assigned}"
                            state="Warning"
                            class="analyticsNumber" />
                        <Text id="assignedLabel" text="{= ${user>/role} === 'Admin' || ${user>/role} === 'Manager' ? 'Assigned (Org)' : 'My Assigned'}" class="analyticsLabel" />
                    </VBox>
                    <!-- In Progress Card -->
                    <VBox id="inProgressBox" alignItems="Center" class="analyticsCard analyticsCardTeal">
                        <core:Icon id="inProgressIcon" src="sap-icon://activity-2" size="1.5rem" color="#0a6ed1" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="inProgressCount"
                            number="{analyticsModel>/inProgress}"
                            state="Information"
                            class="analyticsNumber" />
                        <Text id="inProgressLabel" text="{= ${user>/role} === 'Admin' || ${user>/role} === 'Manager' ? 'In Progress (Org)' : 'My In Progress'}" class="analyticsLabel" />
                    </VBox>
                    <!-- Completed Card -->
                    <VBox id="completedBox" alignItems="Center" class="analyticsCard analyticsCardGreen">
                        <core:Icon id="completedIcon" src="sap-icon://accept" size="1.5rem" color="#107e3e" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="completedCount"
                            number="{analyticsModel>/completed}"
                            state="Success"
                            class="analyticsNumber" />
                        <Text id="completedLabel" text="{= ${user>/role} === 'Admin' || ${user>/role} === 'Manager' ? 'Completed (Org)' : 'My Completed'}" class="analyticsLabel" />
                    </VBox>
                    <!-- Completion Rate Card -->
                    <VBox id="completionRateBox" alignItems="Center" class="analyticsCard analyticsCardPurple">
                        <core:Icon id="completionIcon" src="sap-icon://target-group" size="1.5rem" color="#6c32a9" class="sapUiTinyMarginBottom" />
                        <mc:RadialMicroChart
                            id="completionRadial"
                            percentage="{analyticsModel>/completionPercent}"
                            valueColor="{= ${analyticsModel>/completionPercent} >= 80 ? 'Good' : ${analyticsModel>/completionPercent} >= 50 ? 'Critical' : 'Error' }"
                            size="S" />
                        <Text id="completionRateLabel" text="Completion Rate" class="analyticsLabel" />
                    </VBox>
                </HBox>
                <!-- Charts Row - Status + Module Breakdown (Manager/Admin Only) -->
                <HBox id="chartsHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin"
                    visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }">
                    <!-- Status Distribution Chart -->
                    <VBox id="statusChartBox" class="analyticsCard analyticsCardBlue chartCard">
                        <HBox id="statusChartHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="statusChartIcon" src="sap-icon://horizontal-bar-chart" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                            <Text id="statusChartTitle" text="Status Distribution" class="chartTitle" />
                        </HBox>
                        <mc:StackedBarMicroChart id="statusStackedBar" size="M">
                            <mc:bars>
                                <mc:StackedBarMicroChartBar id="statusBarAssigned" value="{analyticsModel>/assigned}" valueColor="Critical" displayValue="{analyticsModel>/assigned}" />
                                <mc:StackedBarMicroChartBar id="statusBarInProgress" value="{analyticsModel>/inProgress}" valueColor="Neutral" displayValue="{analyticsModel>/inProgress}" />
                                <mc:StackedBarMicroChartBar id="statusBarCompleted" value="{analyticsModel>/completed}" valueColor="Good" displayValue="{analyticsModel>/completed}" />
                            </mc:bars>
                        </mc:StackedBarMicroChart>
                        <HBox id="statusLegendBox" justifyContent="SpaceBetween" class="sapUiTinyMarginTop chartLegendRow">
                            <HBox id="legendAssignedBox" alignItems="Center">
                                <core:Icon id="legendDotAssigned" src="sap-icon://circle-task-2" size="0.625rem" color="#bb0000" class="sapUiTinyMarginEnd" />
                                <Text id="legendAssigned" text="Assigned" class="chartLegendText" />
                            </HBox>
                            <HBox id="legendInProgressBox" alignItems="Center">
                                <core:Icon id="legendDotInProgress" src="sap-icon://circle-task-2" size="0.625rem" color="#5b738b" class="sapUiTinyMarginEnd" />
                                <Text id="legendInProgress" text="In Progress" class="chartLegendText" />
                            </HBox>
                            <HBox id="legendCompletedBox" alignItems="Center">
                                <core:Icon id="legendDotCompleted" src="sap-icon://circle-task-2" size="0.625rem" color="#107e3e" class="sapUiTinyMarginEnd" />
                                <Text id="legendCompleted" text="Completed" class="chartLegendText" />
                            </HBox>
                        </HBox>
                    </VBox>
                    <!-- Module Distribution Chart (built by controller) -->
                    <VBox id="moduleChartBox" class="analyticsCard analyticsCardTeal chartCard">
                        <HBox id="moduleChartHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="moduleChartIcon" src="sap-icon://bar-chart" size="1rem" color="#0a6ed1" class="sapUiTinyMarginEnd" />
                            <Text id="moduleChartTitle" text="Top Modules" class="chartTitle" />
                        </HBox>
                        <VBox id="moduleChartContainer" />
                    </VBox>
                </HBox>
            </Panel>

            <!-- SmartFilterBar: fixed filter boxes in header bar -->
            <smartFilterBar:SmartFilterBar
                id="smartFilterBar"
                entitySet="Trainings"
                persistencyKey="TrainingsSmartFilter"
                enableBasicSearch="true"
                showClearOnFB="true"
                showGoOnFB="true"
                filterBarExpanded="true"
                showFilterConfiguration="false">
                <smartFilterBar:filterGroupItems>
                    <filterBar:FilterGroupItem
                        id="filterTitle"
                        groupName="__$INTERNAL$"
                        name="Title"
                        label="Title"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <Input id="filterTitleInput" placeholder="Search title..." />
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                    <filterBar:FilterGroupItem
                        id="filterRole"
                        groupName="__$INTERNAL$"
                        name="Role"
                        label="Role"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <ComboBox id="filterRoleCombo"
                                placeholder="All Roles"
                                selectionChange="onRoleFilterChange"
                                items="{filterModel>/roles}">
                                <core:Item id="filterRoleItem" key="{filterModel>key}" text="{filterModel>text}" />
                            </ComboBox>
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                    <filterBar:FilterGroupItem
                        id="filterSapModule"
                        groupName="__$INTERNAL$"
                        name="SapModule"
                        label="Module"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <ComboBox id="filterModuleCombo"
                                placeholder="All Modules"
                                selectionChange="onModuleFilterChange"
                                items="{filterModel>/modules}">
                                <core:Item id="filterModuleItem" key="{filterModel>key}" text="{filterModel>text}" />
                            </ComboBox>
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                    <filterBar:FilterGroupItem
                        id="filterLastUpdated"
                        groupName="__$INTERNAL$"
                        name="LastUpdated"
                        label="Last Updated"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <DatePicker id="filterLastUpdatedPicker" placeholder="Select date" />
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                </smartFilterBar:filterGroupItems>
            </smartFilterBar:SmartFilterBar>

            <!-- SmartTable: auto-generates columns from annotations
                 Provides: Variant Management, Column Settings, Export to Excel,
                 auto-column width, responsive popin, row count, full screen -->
            <smartTable:SmartTable
                id="smartTable"
                entitySet="Trainings"
                smartFilterId="smartFilterBar"
                tableType="Table"
                header="Trainings"
                showRowCount="true"
                enableAutoBinding="true"
                showFullScreenButton="true"
                enableExport="true"
                useVariantManagement="true"
                useTablePersonalisation="true"
                persistencyKey="TrainingsSmartTable"
                initialise="onSmartTableInit"
                beforeRebindTable="onBeforeRebindTable">

                <!-- Custom buttons added to SmartTable toolbar alongside auto-generated ones -->
                <smartTable:customToolbar>
                    <OverflowToolbar id="tableToolbar">
                        <ToolbarSpacer id="toolbarSpacer" />
                        <Button
                            id="detailsButton"
                            icon="sap-icon://detail-view"
                            text="View Details"
                            press="onViewDetails" />
                        <Button
                            id="assignButton"
                            icon="sap-icon://add"
                            text="Assign Training"
                            type="Emphasized"
                            press="onAssignTraining"
                            visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }" />
                        <Button
                            id="refreshButton"
                            icon="sap-icon://refresh"
                            tooltip="Refresh Data"
                            press="onRefresh" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
