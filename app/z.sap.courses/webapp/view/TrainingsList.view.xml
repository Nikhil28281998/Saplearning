<mvc:View
    controllerName="z.sap.courses.controller.TrainingsList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:filterBar="sap.ui.comp.filterbar"
    xmlns:mc="sap.suite.ui.microchart">

    <Page
        id="trainingsListPage"
        showNavButton="false"
        enableScrolling="false"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content">

        <!-- Page Header: Title + Role badge + My Assignments -->
        <customHeader>
            <Bar id="headerBar">
                <contentLeft>
                    <Title id="pageTitle" text="{i18n>appTitle}" level="H2" />
                </contentLeft>
                <contentRight>
                    <!-- Role badge: shows the PFCG-detected role (read-only) -->
                    <ObjectStatus
                        id="roleBadge"
                        text="{user>/role}"
                        icon="sap-icon://role"
                        state="{= ${user>/role} === 'Admin' ? 'Success' : ${user>/role} === 'Manager' ? 'Warning' : 'Information' }"
                        class="sapUiSmallMarginEnd" />
                    <!-- Role switcher: visible only in dev/localhost for testing.
                         In production (S/4HANA), role comes from getCurrentRole PFCG check. -->
                    <HBox id="roleBox" alignItems="Center" class="sapUiSmallMarginEnd roleBoxContainer" visible="false">
                        <core:Icon id="roleIcon" src="sap-icon://role" size="1rem" class="sapUiTinyMarginEnd headerIcon" />
                        <Select id="roleSwitcher" selectedKey="{user>/role}" change="onSwitchRole" class="roleSwitcherSelect">
                            <core:Item id="roleAdmin" key="Admin" text="Admin" />
                            <core:Item id="roleManager" key="Manager" text="Manager" />
                            <core:Item id="roleUser" key="User" text="End User" />
                        </Select>
                    </HBox>
                    <Button
                        id="myAssignmentsBtn"
                        text="{i18n>myAssignments}"
                        icon="sap-icon://task"
                        press="onViewAssignments"
                        type="Emphasized" />
                </contentRight>
            </Bar>
        </customHeader>

        <dependents>
            <core:InvisibleText id="trainingsFilterLabel" text="{i18n>trainingsFilterLabel}" />
            <core:InvisibleText id="trainingsTableLabel" text="{i18n>trainingsTableLabel}" />
            <core:InvisibleText id="refreshButtonLabel" text="{i18n>refreshData}" />
        </dependents>

        <content>
            <!-- Analytics Dashboard - Modern Tile Cards -->
            <Panel
                id="analyticsPanel"
                expandable="true"
                expanded="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }"
                headerText="{i18n>analyticsHeader}"
                class="sapUiSmallMarginBottom analyticsPanel">
                <HBox id="analyticsHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin analyticsContainer">
                    <!-- Total Trainings Card -->
                    <VBox id="totalBox" alignItems="Center" class="analyticsCard analyticsCardBlue">
                        <core:Icon id="totalIcon" src="sap-icon://course-book" size="1.5rem" color="#0854a0" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="totalTrainingsCount"
                            number="{analyticsModel>/totalTrainings}"
                            state="Information"
                            class="analyticsNumber" />
                        <Text id="totalLabel" text="{i18n>totalCatalog}" class="analyticsLabel" />
                    </VBox>
                    <!-- Assigned Card (Manager/Admin: org-wide | User: my assignments) -->
                    <VBox id="assignedBox" alignItems="Center" class="analyticsCard analyticsCardOrange">
                        <core:Icon id="assignedIcon" src="sap-icon://pending" size="1.5rem" color="#e76500" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="assignedCount"
                            number="{analyticsModel>/assigned}"
                            state="Warning"
                            class="analyticsNumber" />
                        <Text id="assignedLabel" text="{i18n>pending}" class="analyticsLabel" />
                    </VBox>
                    <!-- In Progress Card -->
                    <VBox id="inProgressBox" alignItems="Center" class="analyticsCard analyticsCardTeal">
                        <core:Icon id="inProgressIcon" src="sap-icon://activity-2" size="1.5rem" color="#0a6ed1" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="inProgressCount"
                            number="{analyticsModel>/inProgress}"
                            state="Information"
                            class="analyticsNumber" />
                        <Text id="inProgressLabel" text="{i18n>learning}" class="analyticsLabel" />
                    </VBox>
                    <!-- Completed Card -->
                    <VBox id="completedBox" alignItems="Center" class="analyticsCard analyticsCardGreen">
                        <core:Icon id="completedIcon" src="sap-icon://accept" size="1.5rem" color="#107e3e" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            id="completedCount"
                            number="{analyticsModel>/completed}"
                            state="Success"
                            class="analyticsNumber" />
                        <Text id="completedLabel" text="{i18n>done}" class="analyticsLabel" />
                    </VBox>
                    <!-- Completion Rate Card -->
                    <VBox id="completionRateBox" alignItems="Center" class="analyticsCard analyticsCardPurple">
                        <core:Icon id="completionIcon" src="sap-icon://target-group" size="1.5rem" color="#6c32a9" class="sapUiTinyMarginBottom" />
                        <mc:RadialMicroChart
                            id="completionRadial"
                            percentage="{analyticsModel>/completionPercent}"
                            valueColor="{= ${analyticsModel>/completionPercent} >= 80 ? 'Good' : ${analyticsModel>/completionPercent} >= 50 ? 'Critical' : 'Error' }"
                            size="S" />
                        <Text id="completionRateLabel" text="{i18n>completionRate}" class="analyticsLabel" />
                    </VBox>
                </HBox>
                <!-- Charts Row - Status + Module Breakdown (Manager/Admin Only) -->
                <HBox id="chartsHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin"
                    visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }">
                    <!-- Status Distribution Chart -->
                    <VBox id="statusChartBox" class="analyticsCard analyticsCardBlue chartCard">
                        <HBox id="statusChartHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="statusChartIcon" src="sap-icon://horizontal-bar-chart" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                            <Text id="statusChartTitle" text="{i18n>statusDistribution}" class="chartTitle" />
                        </HBox>
                        <mc:StackedBarMicroChart id="statusStackedBar" size="L" width="100%">
                            <mc:bars>
                                <mc:StackedBarMicroChartBar id="statusBarAssigned" value="{analyticsModel>/assigned}" valueColor="Critical" displayValue="{analyticsModel>/assigned}" />
                                <mc:StackedBarMicroChartBar id="statusBarInProgress" value="{analyticsModel>/inProgress}" valueColor="Neutral" displayValue="{analyticsModel>/inProgress}" />
                                <mc:StackedBarMicroChartBar id="statusBarCompleted" value="{analyticsModel>/completed}" valueColor="Good" displayValue="{analyticsModel>/completed}" />
                            </mc:bars>
                        </mc:StackedBarMicroChart>
                        <HBox id="statusLegendBox" justifyContent="SpaceBetween" class="sapUiTinyMarginTop chartLegendRow">
                            <HBox id="legendAssignedBox" alignItems="Center">
                                <core:Icon id="legendDotAssigned" src="sap-icon://circle-task-2" size="0.625rem" color="#bb0000" class="sapUiTinyMarginEnd" />
                                <Text id="legendAssigned" text="{i18n>pending}" class="chartLegendText" />
                            </HBox>
                            <HBox id="legendInProgressBox" alignItems="Center">
                                <core:Icon id="legendDotInProgress" src="sap-icon://circle-task-2" size="0.625rem" color="#5b738b" class="sapUiTinyMarginEnd" />
                                <Text id="legendInProgress" text="{i18n>learning}" class="chartLegendText" />
                            </HBox>
                            <HBox id="legendCompletedBox" alignItems="Center">
                                <core:Icon id="legendDotCompleted" src="sap-icon://circle-task-2" size="0.625rem" color="#107e3e" class="sapUiTinyMarginEnd" />
                                <Text id="legendCompleted" text="{i18n>done}" class="chartLegendText" />
                            </HBox>
                        </HBox>
                    </VBox>
                    <!-- Module Distribution Chart (built by controller) -->
                    <VBox id="moduleChartBox" class="analyticsCard analyticsCardTeal chartCard">
                        <HBox id="moduleChartHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="moduleChartIcon" src="sap-icon://bar-chart" size="1rem" color="#0a6ed1" class="sapUiTinyMarginEnd" />
                            <Text id="moduleChartTitle" text="{i18n>topModules}" class="chartTitle" />
                        </HBox>
                        <VBox id="moduleChartContainer" />
                    </VBox>
                </HBox>
            </Panel>

            <!-- ============================================================ -->
            <!-- TEAM ANALYTICS – Manager/Admin only: org-wide completion     -->
            <!-- ============================================================ -->
            <Panel
                id="teamAnalyticsPanel"
                expandable="true"
                expanded="true"
                headerText="{i18n>teamAnalyticsHeader}"
                class="sapUiSmallMarginBottom analyticsPanel"
                visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }">
                <HBox id="teamAnalyticsHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin analyticsContainer">
                    <VBox id="teamTotalBox" alignItems="Center" class="analyticsCard analyticsCardBlue">
                        <core:Icon id="teamTotalIcon" src="sap-icon://group" size="1.5rem" color="#0854a0" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamTotalCount" number="{teamAnalytics>/totalAssignments}" state="Information" class="analyticsNumber" />
                        <Text id="teamTotalLabel" text="{i18n>teamTotalAssignments}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="teamAssignedBox" alignItems="Center" class="analyticsCard analyticsCardOrange">
                        <core:Icon id="teamAssignedIcon" src="sap-icon://pending" size="1.5rem" color="#e76500" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamAssignedCount" number="{teamAnalytics>/assigned}" state="Warning" class="analyticsNumber" />
                        <Text id="teamAssignedLabel" text="{i18n>teamPending}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="teamInProgressBox" alignItems="Center" class="analyticsCard analyticsCardTeal">
                        <core:Icon id="teamInProgressIcon" src="sap-icon://activity-2" size="1.5rem" color="#0a6ed1" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamInProgressCount" number="{teamAnalytics>/inProgress}" state="Information" class="analyticsNumber" />
                        <Text id="teamInProgressLabel" text="{i18n>teamInProgress}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="teamCompletedBox" alignItems="Center" class="analyticsCard analyticsCardGreen">
                        <core:Icon id="teamCompletedIcon" src="sap-icon://accept" size="1.5rem" color="#107e3e" class="sapUiTinyMarginBottom" />
                        <ObjectNumber id="teamCompletedCount" number="{teamAnalytics>/completed}" state="Success" class="analyticsNumber" />
                        <Text id="teamCompletedLabel" text="{i18n>teamCompleted}" class="analyticsLabel" />
                    </VBox>
                    <VBox id="teamCompletionBox" alignItems="Center" class="analyticsCard analyticsCardPurple">
                        <core:Icon id="teamCompletionIcon" src="sap-icon://performance" size="1.5rem" color="#6c32a9" class="sapUiTinyMarginBottom" />
                        <mc:RadialMicroChart id="teamCompletionRadial" percentage="{teamAnalytics>/completionPercent}" valueColor="{= ${teamAnalytics>/completionPercent} >= 80 ? 'Good' : ${teamAnalytics>/completionPercent} >= 50 ? 'Critical' : 'Error' }" size="S" />
                        <Text id="teamCompletionLabel" text="{i18n>teamCompletionRate}" class="analyticsLabel" />
                    </VBox>
                </HBox>
                <HBox id="teamChartsHBox" justifyContent="SpaceAround" wrap="Wrap" class="sapUiSmallMargin">
                    <VBox id="teamStatusChartBox" class="analyticsCard analyticsCardBlue chartCard">
                        <HBox id="teamStatusHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="teamStatusIcon" src="sap-icon://horizontal-bar-chart" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                            <Text id="teamStatusTitle" text="{i18n>teamStatusDistribution}" class="chartTitle" />
                        </HBox>
                        <mc:StackedBarMicroChart id="teamStatusBar" size="L" width="100%">
                            <mc:bars>
                                <mc:StackedBarMicroChartBar id="teamBarAssigned" value="{teamAnalytics>/assigned}" valueColor="Critical" displayValue="{teamAnalytics>/assigned}" />
                                <mc:StackedBarMicroChartBar id="teamBarInProgress" value="{teamAnalytics>/inProgress}" valueColor="Neutral" displayValue="{teamAnalytics>/inProgress}" />
                                <mc:StackedBarMicroChartBar id="teamBarCompleted" value="{teamAnalytics>/completed}" valueColor="Good" displayValue="{teamAnalytics>/completed}" />
                            </mc:bars>
                        </mc:StackedBarMicroChart>
                        <HBox id="teamLegendBox" justifyContent="SpaceBetween" class="sapUiTinyMarginTop chartLegendRow">
                            <HBox id="teamLegendPending" alignItems="Center">
                                <core:Icon id="teamLegDotP" src="sap-icon://circle-task-2" size="0.625rem" color="#bb0000" class="sapUiTinyMarginEnd" />
                                <Text id="teamLegTextP" text="{i18n>pending}" class="chartLegendText" />
                            </HBox>
                            <HBox id="teamLegendIP" alignItems="Center">
                                <core:Icon id="teamLegDotIP" src="sap-icon://circle-task-2" size="0.625rem" color="#5b738b" class="sapUiTinyMarginEnd" />
                                <Text id="teamLegTextIP" text="{i18n>learning}" class="chartLegendText" />
                            </HBox>
                            <HBox id="teamLegendDone" alignItems="Center">
                                <core:Icon id="teamLegDotD" src="sap-icon://circle-task-2" size="0.625rem" color="#107e3e" class="sapUiTinyMarginEnd" />
                                <Text id="teamLegTextD" text="{i18n>done}" class="chartLegendText" />
                            </HBox>
                        </HBox>
                    </VBox>
                    <VBox id="teamUserChartBox" class="analyticsCard analyticsCardTeal chartCard">
                        <HBox id="teamUserChartHeader" alignItems="Center" class="sapUiTinyMarginBottom">
                            <core:Icon id="teamUserChartIcon" src="sap-icon://customer" size="1rem" color="#0a6ed1" class="sapUiTinyMarginEnd" />
                            <Text id="teamUserChartTitle" text="{i18n>teamUserProgress}" class="chartTitle" />
                        </HBox>
                        <VBox id="teamUserListContainer" />
                    </VBox>
                </HBox>
            </Panel>

            <!-- SmartFilterBar: Go + Adapt Filters with explicit Role/Module dropdown filters -->
            <smartFilterBar:SmartFilterBar
                id="smartFilterBar"
                entitySet="Trainings"
                persistencyKey="TrainingsSmartFilter"
                ariaLabelledBy="trainingsFilterLabel"
                enableBasicSearch="true"
                showClearOnFB="false"
                showRestoreOnFB="false"
                showGoOnFB="true"
                filterBarExpanded="true"
                showFilterConfiguration="true"
                useDateRangeType="true">
                <smartFilterBar:controlConfiguration>
                    <smartFilterBar:ControlConfiguration id="ccRole" key="Role" filterType="single" />
                    <smartFilterBar:ControlConfiguration id="ccSapModule" key="SapModule" filterType="single" />
                </smartFilterBar:controlConfiguration>
                <smartFilterBar:filterGroupItems>
                    <filterBar:FilterGroupItem
                        id="fgiRole"
                        name="Role"
                        label="{i18n>roleLabel}"
                        groupName="_BASIC"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <Select id="filterRole" forceSelection="false" selectedKey="" change="onRoleFilterChange"
                                items="{filterData>/roles}">
                                <core:Item id="roleItem" key="{filterData>key}" text="{filterData>text}" />
                            </Select>
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                    <filterBar:FilterGroupItem
                        id="fgiModule"
                        name="SapModule"
                        label="{i18n>moduleLabel}"
                        groupName="_BASIC"
                        visibleInFilterBar="true">
                        <filterBar:control>
                            <Select id="filterModule" forceSelection="false" selectedKey="" change="onModuleFilterChange"
                                items="{filterData>/modules}">
                                <core:Item id="moduleItem" key="{filterData>key}" text="{filterData>text}" />
                            </Select>
                        </filterBar:control>
                    </filterBar:FilterGroupItem>
                </smartFilterBar:filterGroupItems>
            </smartFilterBar:SmartFilterBar>

            <!-- SmartTable: auto-generates columns from annotations
                 Provides: Variant Management, Column Settings, Export to Excel,
                 auto-column width, responsive popin, row count, full screen -->
            <smartTable:SmartTable
                id="smartTable"
                entitySet="Trainings"
                smartFilterId="smartFilterBar"
                tableType="Table"
                header="{i18n>columnTraining}"
                showRowCount="true"
                enableAutoBinding="true"
                showFullScreenButton="true"
                enableExport="true"
                useVariantManagement="false"
                useTablePersonalisation="true"
                persistencyKey="TrainingsSmartTableV3"
                initialise="onSmartTableInit"
                beforeRebindTable="onBeforeRebindTable"
                fitContainer="true"
                enableAutoColumnWidth="true"
                ignoredFields="Id"
                initiallyVisibleFields="Title,Role,SapModule,Description,LastUpdated,Url,SapHelpLink"
                requestAtLeastFields="Id,Url,SapHelpLink">

                <!-- Custom buttons added to SmartTable toolbar alongside auto-generated ones -->
                <smartTable:customToolbar>
                    <OverflowToolbar id="tableToolbar">
                        <Button
                            id="createTrainingBtn"
                            icon="sap-icon://add"
                            text="{i18n>createBtn}"
                            type="Emphasized"
                            press="onCreateTraining"
                            visible="{= ${user>/role} === 'Admin' }" />
                        <Button
                            id="deleteTrainingBtn"
                            icon="sap-icon://delete"
                            text="{i18n>deleteBtn}"
                            type="Reject"
                            press="onDeleteTraining"
                            visible="{= ${user>/role} === 'Admin' }" />
                        <ToolbarSpacer id="toolbarSpacer" />
                        <Button
                            id="detailsButton"
                            icon="sap-icon://detail-view"
                            text="{i18n>viewDetails}"
                            press="onViewDetails" />
                        <Button
                            id="assignButton"
                            icon="sap-icon://person-placeholder"
                            text="{i18n>assignTraining}"
                            type="Attention"
                            press="onAssignTraining"
                            visible="{= ${user>/role} === 'Manager' || ${user>/role} === 'Admin' }" />
                        <Button
                            id="refreshButton"
                            icon="sap-icon://refresh"
                            tooltip="{i18n>refreshData}"
                            ariaLabelledBy="refreshButtonLabel"
                            press="onRefresh" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
