<mvc:View
    controllerName="z.sap.courses.controller.App"
    displayBlock="true"
    height="100%"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">
    <!-- Shell with appWidthLimited="false" = standard Fiori full-screen pattern.
         This is what SAP standard apps (MM, SD, FI) use to fill the entire screen.
         Without this, sap.m.Shell defaults to max-width ~1280px centered. -->
    <Shell id="shell" appWidthLimited="false">
        <App id="app" height="100%" autoFocus="true" class="sapCoursesApp">
            <!-- Pages will be inserted here by router -->
        </App>
    </Shell>
</mvc:View>
