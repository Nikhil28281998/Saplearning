<mvc:View
    controllerName="z.sap.courses.controller.App"
    displayBlock="true"
    height="100%"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">
    <!-- NO sap.m.Shell here — app runs inside FLP which provides its own Shell.
         Nesting Shell-in-FLP-Shell causes a fixed-width centered container.
         Width is controlled via CSS targeting FLP containers + App.controller.js -->
    <App id="app" height="100%" autoFocus="true" class="sapCoursesApp">
        <!-- Pages will be inserted here by router -->
    </App>
</mvc:View>
