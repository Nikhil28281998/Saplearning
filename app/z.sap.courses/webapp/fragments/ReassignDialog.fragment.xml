<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!-- C2: Reassign assignment to a different team member -->
    <Dialog
        id="reassignDialog"
        title="{i18n>reassignTitle}"
        contentWidth="480px"
        draggable="true">

        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    id="reassignInfoStrip"
                    text="{= 'Reassigning: ' + ${reassignModel>/trainingTitle} + ' (currently: ' + ${reassignModel>/currentUserId} + ')'}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <Label id="reassignUserLabel" text="{i18n>reassignTo}" required="true" />
                <Select id="reassignUserSelect" selectedKey="{reassignModel>/newUserId}" width="100%"
                    items="{reassignModel>/users}">
                    <core:Item id="reassignUserItem"
                        key="{reassignModel>UserId}"
                        text="{reassignModel>UserId} - {reassignModel>FirstName} {reassignModel>LastName}" />
                </Select>

                <MessageStrip
                    id="reassignErrorStrip"
                    text="{reassignModel>/error}"
                    visible="{= !!${reassignModel>/error} }"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />
            </VBox>
        </content>

        <beginButton>
            <Button id="reassignSubmitBtn" text="{i18n>reassignButton}" type="Emphasized"
                icon="sap-icon://forward" press=".onReassignSubmit"
                enabled="{= !${reassignModel>/submitting} }" />
        </beginButton>
        <endButton>
            <Button id="reassignCancelBtn" text="{i18n>cancelButton}" press=".onReassignCancel" />
        </endButton>
    </Dialog>

</core:FragmentDefinition>
