<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!--
        H1/H2/H3/H5 FIX: Redesigned team user progress rows.
        Two-row layout: top has avatar + name + status, bottom has full-width progress bar.
        Prevents truncation and overlap issues.
    -->
    <CustomListItem type="Inactive" class="teamUserRow sapUiTinyMarginBottom">
        <VBox width="100%">
            <!-- Row 1: Avatar + Name + Overdue badge + Completion % -->
            <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%" class="sapUiTinyMarginBottom">
                <HBox alignItems="Center" width="70%">
                    <Text text="{= ${teamAnalytics>userName} ? ${teamAnalytics>userName}.charAt(0).toUpperCase() : '?' }" class="userAvatar" />
                    <VBox class="sapUiTinyMarginBegin">
                        <Text text="{teamAnalytics>userName}" wrapping="true" class="teamUserName" />
                        <Text text="{teamAnalytics>userId}" wrapping="false" class="teamUserId" />
                    </VBox>
                </HBox>
                <HBox alignItems="Center">
                    <ObjectStatus
                        text="{= ${teamAnalytics>overdue} > 0 ? ${teamAnalytics>overdue} + ' overdue' : '' }"
                        state="Error"
                        icon="{= ${teamAnalytics>overdue} > 0 ? 'sap-icon://alert' : '' }"
                        visible="{= ${teamAnalytics>overdue} > 0 }"
                        class="sapUiTinyMarginEnd teamUserOverdueBadge" />
                    <ObjectStatus
                        text="{= (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) === 100 ? 'Done' : (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) + '%' }"
                        state="{= (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) >= 100 ? 'Success' : (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) >= 50 ? 'Warning' : 'Error' }"
                        icon="{= (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) === 100 ? 'sap-icon://accept' : '' }"
                        class="teamUserStatus" />
                </HBox>
            </HBox>
            <!-- Row 2: Full-width progress bar -->
            <ProgressIndicator
                percentValue="{= ${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0 }"
                displayValue="{= ${teamAnalytics>completed} + '/' + ${teamAnalytics>total} + ' (' + (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) + '%)' }"
                state="{= (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) >= 100 ? 'Success' : (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) >= 50 ? 'Warning' : 'Error' }"
                width="100%"
                height="1.5rem" />
        </VBox>
    </CustomListItem>
</core:FragmentDefinition>
