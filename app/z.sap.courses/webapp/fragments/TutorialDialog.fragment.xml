<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Dialog
        title="{tutorialData>/title}"
        contentWidth="40rem"
        contentHeight="auto"
        draggable="true"
        resizable="true"
        class="sapUiContentPadding">

        <content>
            <IconTabBar id="tutorialTabBar" selectedKey="{tutorialData>/selectedTab}" class="sapUiNoContentPadding">
                <items>
                    <!-- Getting Started Tab -->
                    <IconTabFilter id="tutorialTabStart" key="start" text="{i18n>gettingStartedTab}" icon="sap-icon://begin">
                        <VBox class="sapUiSmallMargin">
                            <Title text="{i18n>welcomeTitle}" level="H4" class="sapUiSmallMarginBottom" />
                            <MessageStrip
                                text="{i18n>tutorialGuideText}"
                                type="Information"
                                showIcon="true"
                                class="sapUiSmallMarginBottom" />
                            <FormattedText
                                htmlText="{tutorialData>/gettingStarted}"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </IconTabFilter>

                    <!-- Features Tab -->
                    <IconTabFilter id="tutorialTabFeatures" key="features" text="{i18n>featuresTab}" icon="sap-icon://list">
                        <VBox class="sapUiSmallMargin">
                            <Title text="{i18n>keyFeaturesTitle}" level="H4" class="sapUiSmallMarginBottom" />
                            <FormattedText
                                htmlText="{tutorialData>/features}"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </IconTabFilter>

                    <!-- Tips Tab -->
                    <IconTabFilter id="tutorialTabTips" key="tips" text="{i18n>tipsTab}" icon="sap-icon://hint">
                        <VBox class="sapUiSmallMargin">
                            <Title text="{i18n>proTipsTitle}" level="H4" class="sapUiSmallMarginBottom" />
                            <FormattedText
                                htmlText="{tutorialData>/tips}"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>

        <endButton>
            <Button text="{i18n>gotItButton}" type="Emphasized" press="onCloseTutorial" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
