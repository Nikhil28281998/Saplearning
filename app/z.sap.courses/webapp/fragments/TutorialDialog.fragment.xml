<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Dialog
        title="{tutorialData>/title}"
        contentWidth="40rem"
        contentHeight="auto"
        draggable="true"
        resizable="true"
        class="sapUiContentPadding">

        <content>
            <IconTabBar id="tutorialTabBar" selectedKey="{tutorialData>/selectedTab}" class="sapUiNoContentPadding">
                <items>
                    <!-- Getting Started Tab -->
                    <IconTabFilter id="tutorialTabStart" key="start" text="Getting Started" icon="sap-icon://begin">
                        <VBox class="sapUiSmallMargin">
                            <Title text="Welcome to SAP Learning Hub" level="H4" class="sapUiSmallMarginBottom" />
                            <MessageStrip
                                text="This guide will help you get the most out of the application based on your role."
                                type="Information"
                                showIcon="true"
                                class="sapUiSmallMarginBottom" />
                            <FormattedText
                                htmlText="{tutorialData>/gettingStarted}"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </IconTabFilter>

                    <!-- Features Tab -->
                    <IconTabFilter id="tutorialTabFeatures" key="features" text="Features" icon="sap-icon://list">
                        <VBox class="sapUiSmallMargin">
                            <Title text="Key Features" level="H4" class="sapUiSmallMarginBottom" />
                            <FormattedText
                                htmlText="{tutorialData>/features}"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </IconTabFilter>

                    <!-- Tips Tab -->
                    <IconTabFilter id="tutorialTabTips" key="tips" text="Tips &amp; Tricks" icon="sap-icon://hint">
                        <VBox class="sapUiSmallMargin">
                            <Title text="Pro Tips" level="H4" class="sapUiSmallMarginBottom" />
                            <FormattedText
                                htmlText="{tutorialData>/tips}"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>

        <endButton>
            <Button text="Got it!" type="Emphasized" press="onCloseTutorial" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
