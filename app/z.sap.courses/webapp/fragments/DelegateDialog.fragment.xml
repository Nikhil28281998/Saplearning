<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!-- C6: Manager Delegation Dialog -->
    <Dialog
        id="delegateDialog"
        title="{i18n>delegateTitle}"
        contentWidth="480px"
        draggable="true">

        <content>
            <VBox class="sapUiSmallMargin">
                <!-- Current delegation status -->
                <MessageStrip
                    id="delegateStatusStrip"
                    text="{= ${delegateModel>/activeDelegateName} ? ${i18n>delegateActive}.replace('{0}', ${delegateModel>/activeDelegateName}) : ${i18n>delegateNone} }"
                    type="{= ${delegateModel>/activeDelegateName} ? 'Information' : 'None' }"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <!-- Select delegate user -->
                <Label id="delegateToLabel" text="{i18n>delegateTo}" class="sapUiSmallMarginTop" />
                <Select id="delegateUserSelect"
                    selectedKey="{delegateModel>/selectedUserId}"
                    width="100%"
                    items="{delegateModel>/users}">
                    <core:Item key="{delegateModel>UserId}" text="{delegateModel>UserId} - {delegateModel>FirstName} {delegateModel>LastName}" />
                </Select>

                <!-- Error strip -->
                <MessageStrip
                    id="delegateErrorStrip"
                    text="{delegateModel>/error}"
                    visible="{= !!${delegateModel>/error} }"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />
            </VBox>
        </content>

        <beginButton>
            <Button
                id="delegateSubmitBtn"
                text="{i18n>delegateTitle}"
                type="Emphasized"
                icon="sap-icon://accept"
                enabled="{= !${delegateModel>/submitting} }"
                press=".onDelegateSubmit" />
        </beginButton>
        <buttons>
            <Button
                id="delegateRevokeBtn"
                text="{i18n>delegateRevoke}"
                type="Reject"
                icon="sap-icon://decline"
                visible="{= !!${delegateModel>/activeDelegateName} }"
                press=".onDelegateRevoke" />
        </buttons>
        <endButton>
            <Button id="delegateCancelBtn" text="{i18n>cancelButton}" press=".onDelegateCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
