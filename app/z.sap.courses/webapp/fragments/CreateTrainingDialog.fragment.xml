<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog
        id="createTrainingDialog"
        title="{i18n>createTrainingTitle}"
        contentWidth="560px"
        draggable="true"
        resizable="true">

        <content>
            <VBox id="createDialogVBox" class="sapUiSmallMargin">
                <form:SimpleForm
                    id="createForm"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                    columnsXL="1" columnsL="1" columnsM="1">
                    <form:content>
                        <Label id="createLabelTitle" text="{i18n>titleLabel}" required="true" />
                        <Input id="createInputTitle" value="{createModel>/title}" placeholder="Training title" />

                        <Label id="createLabelRole" text="{i18n>roleLabel}" />
                        <Select
                            id="createSelectRole"
                            selectedKey="{createModel>/role}"
                            forceSelection="false"
                            items="{
                                path: '/RolesVH',
                                sorter: { path: 'Role', descending: false }
                            }">
                            <core:Item id="createRoleItem" key="{Role}" text="{Role}" />
                        </Select>

                        <Label id="createLabelModule" text="{i18n>moduleLabel}" />
                        <Select
                            id="createSelectModule"
                            selectedKey="{createModel>/sapModule}"
                            forceSelection="false"
                            items="{
                                path: '/ModulesVH',
                                sorter: { path: 'SapModule', descending: false }
                            }">
                            <core:Item id="createModuleItem" key="{SapModule}" text="{SapModule}" />
                        </Select>

                        <Label id="createLabelDesc" text="{i18n>descriptionLabel}" />
                        <TextArea id="createInputDesc" value="{createModel>/description}" rows="3" placeholder="Brief description" />

                        <Label id="createLabelUrl" text="URL" required="true" />
                        <Input id="createInputUrl" value="{createModel>/url}" type="Url" placeholder="https://learning.sap.com/..." />

                        <Label id="createLabelHelp" text="{i18n>sapHelpLabel}" />
                        <Input id="createInputHelp" value="{createModel>/sapHelpLink}" type="Url" placeholder="https://help.sap.com/..." />
                    </form:content>
                </form:SimpleForm>

                <MessageStrip
                    id="createErrorStrip"
                    text="{createModel>/error}"
                    visible="{= !!${createModel>/error} }"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />
            </VBox>
        </content>

        <beginButton>
            <Button
                id="createSaveBtn"
                text="{i18n>createBtn}"
                type="Emphasized"
                icon="sap-icon://save"
                enabled="{= !${createModel>/submitting} }"
                press=".onCreateTrainingSave" />
        </beginButton>
        <endButton>
            <Button
                id="createCancelBtn"
                text="{i18n>cancelButton}"
                press=".onCreateTrainingCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
