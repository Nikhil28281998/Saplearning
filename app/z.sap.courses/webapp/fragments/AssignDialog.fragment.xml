<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog
        id="assignTrainingDialog"
        title="Assign Training to Team"
        contentWidth="620px"
        verticalScrolling="true"
        draggable="true"
        resizable="true">

        <content>
            <VBox id="assignDialogVBox" class="sapUiSmallMargin">

                <!-- Section 1: Selected Trainings (read-only summary) -->
                <Panel id="assignTrainingsPanel" headerText="Selected Trainings ({= ${assignModel>/trainings}.length })">
                    <List id="assignTrainingsList" items="{assignModel>/trainings}" noDataText="No trainings selected">
                        <StandardListItem
                            id="assignTrainingListItem"
                            title="{assignModel>Title}"
                            description="{assignModel>Topic} | {assignModel>SapModule}"
                            icon="sap-icon://course-book"
                            type="Inactive" />
                    </List>
                </Panel>

                <form:SimpleForm
                    id="assignForm"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                    emptySpanXL="0" emptySpanL="0" emptySpanM="0"
                    columnsXL="1" columnsL="1" columnsM="1"
                    adjustLabelSpan="false">
                    <form:content>
                        <!-- Section 2: Assign To -->
                        <core:Title id="assignTitleAssignTo" text="Assign To" />
                        <Label id="assignLabelUserId" text="Team Members" required="true" />
                        <MultiComboBox
                            id="assignUserIdInput"
                            width="100%"
                            placeholder="Select one or more team members..."
                            selectedKeys="{assignModel>/selectedUserKeys}"
                            selectionChange=".onAssignUserSelectionChange"
                            items="{assignModel>/users}">
                            <core:Item
                                id="assignUserItem"
                                key="{assignModel>UserId}"
                                text="{assignModel>UserId} - {assignModel>FirstName} {assignModel>LastName}" />
                        </MultiComboBox>

                        <Label id="assignLabelSelectedCount" text="Selected" />
                        <Text id="assignSelectedCount" text="{= ${assignModel>/selectedUserKeys}.length + ' team member(s) x ' + ${assignModel>/trainings}.length + ' training(s) = ' + (${assignModel>/selectedUserKeys}.length * ${assignModel>/trainings}.length) + ' assignment(s)'}" />

                        <!-- Section 3: Schedule -->
                        <core:Title id="assignTitleSchedule" text="Schedule" />
                        <Label id="assignLabelDueDate" text="Due Date" />
                        <DatePicker
                            id="assignDueDate"
                            width="100%"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="long"
                            value="{assignModel>/dueDate}"
                            placeholder="Select due date" />
                    </form:content>
                </form:SimpleForm>

                <MessageStrip
                    id="assignErrorStrip"
                    text="{assignModel>/error}"
                    visible="{= !!${assignModel>/error} }"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />
            </VBox>
        </content>

        <beginButton>
            <Button
                id="assignSubmitBtn"
                text="Assign"
                type="Emphasized"
                icon="sap-icon://accept"
                enabled="{= !${assignModel>/submitting} }"
                press=".onAssignSubmit" />
        </beginButton>
        <endButton>
            <Button id="assignCancelBtn" text="Cancel" press=".onAssignCancel" />
        </endButton>
    </Dialog>

</core:FragmentDefinition>
