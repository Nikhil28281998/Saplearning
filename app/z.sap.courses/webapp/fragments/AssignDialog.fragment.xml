<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog
        id="assignTrainingDialog"
        title="{i18n>assignDialogTitle}"
        contentWidth="620px"
        verticalScrolling="true"
        draggable="true"
        resizable="true">

        <content>
            <VBox id="assignDialogVBox" class="sapUiSmallMargin">

                <!-- Section 1: Selected Trainings (read-only summary) -->
                <Panel id="assignTrainingsPanel" headerText="{parts: ['i18n>selectedTrainingsCount', 'assignModel>/trainings'], formatter: '.formatSelectedTrainingsHeader'}">
                    <List id="assignTrainingsList" items="{assignModel>/trainings}" noDataText="{i18n>noTrainingsSelectedText}">
                        <StandardListItem
                            id="assignTrainingListItem"
                            title="{assignModel>Title}"
                            description="{assignModel>Role} | {assignModel>Topic} | {assignModel>SapModule}"
                            icon="sap-icon://course-book"
                            type="Inactive" />
                    </List>
                </Panel>

                <form:SimpleForm
                    id="assignForm"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                    emptySpanXL="0" emptySpanL="0" emptySpanM="0"
                    columnsXL="1" columnsL="1" columnsM="1"
                    adjustLabelSpan="false">
                    <form:content>
                        <!-- Section 2: Assign To -->
                        <core:Title id="assignTitleAssignTo" text="{i18n>assignToTitle}" />
                        <Label id="assignLabelUserId" text="{i18n>teamMembersLabel}" required="true" />
                        <MultiComboBox
                            id="assignUserIdInput"
                            width="100%"
                            placeholder="{i18n>teamMembersPlaceholder}"
                            selectedKeys="{assignModel>/selectedUserKeys}"
                            selectionChange=".onAssignUserSelectionChange"
                            items="{assignModel>/users}">
                            <core:Item
                                id="assignUserItem"
                                key="{assignModel>UserId}"
                                text="{assignModel>UserId} - {assignModel>FirstName} {assignModel>LastName}" />
                        </MultiComboBox>

                        <Label id="assignLabelSelectedCount" text="{i18n>selectedCountLabel}" />
                        <Text id="assignSelectedCount" text="{= ${assignModel>/selectedUserKeys}.length + ' team member(s) x ' + ${assignModel>/trainings}.length + ' training(s) = ' + (${assignModel>/selectedUserKeys}.length * ${assignModel>/trainings}.length) + ' assignment(s)'}" />

                        <!-- Section 3: Schedule -->
                        <core:Title id="assignTitleSchedule" text="{i18n>schedule}" />
                        <Label id="assignLabelDueDate" text="{i18n>dueDateLabel}" />
                        <DatePicker
                            id="assignDueDate"
                            width="100%"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="long"
                            value="{assignModel>/dueDate}"
                            placeholder="{i18n>selectDueDatePlaceholder}" />
                    </form:content>
                </form:SimpleForm>

                <MessageStrip
                    id="assignErrorStrip"
                    text="{assignModel>/error}"
                    visible="{= !!${assignModel>/error} }"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />
            </VBox>
        </content>

        <beginButton>
            <Button
                id="assignSubmitBtn"
                text="{i18n>assignButton}"
                type="Emphasized"
                icon="sap-icon://accept"
                enabled="{= !${assignModel>/submitting} }"
                press=".onAssignSubmit" />
        </beginButton>
        <endButton>
            <Button id="assignCancelBtn" text="{i18n>cancelButton}" press=".onAssignCancel" />
        </endButton>
    </Dialog>

</core:FragmentDefinition>
