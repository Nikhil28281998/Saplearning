<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified">
    
    <Dialog
        id="csvImportDialog"
        title="{i18n>importTitle}"
        contentWidth="600px"
        contentHeight="500px"
        resizable="true"
        draggable="true">
        
        <content>
            <VBox id="importContentBox" class="sapUiSmallMargin">
                
                <!-- Instructions -->
                <MessageStrip
                    id="csvInstructions"
                    text="{i18n>csvInstructions}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>
                
                <!-- File Upload -->
                <l:VerticalLayout id="fileUploadLayout" class="sapUiSmallMarginBottom">
                    <Label id="csvFileLabel" text="{i18n>selectCsvFile}" required="true"/>
                    <u:FileUploader
                        id="fileUploader"
                        name="csvFile"
                        uploadUrl=""
                        tooltip="Upload CSV file"
                        placeholder="{i18n>csvFilePlaceholder}"
                        fileType="csv"
                        mimeType="text/csv,application/vnd.ms-excel"
                        maximumFileSize="5"
                        change=".onFileChange"
                        width="100%"
                        class="sapUiSmallMarginTop"/>
                    <Text id="maxFileSizeText" text="{i18n>maxFileSize}" class="sapUiTinyMarginTop"/>
                </l:VerticalLayout>
                
                <!-- Preview Section -->
                <Panel
                    id="previewPanel"
                    headerText="{i18n>previewHeader}"
                    expandable="true"
                    expanded="false"
                    visible="false"
                    class="sapUiSmallMarginTop">
                    <content>
                        <VBox id="previewContent">
                            <HBox id="recordCountBox" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <Text id="recordsLabel" text="{i18n>recordsToImport}" class="sapUiSmallMarginEnd"/>
                                <ObjectNumber
                                    id="recordCount"
                                    number="0"
                                    emphasized="true"/>
                            </HBox>
                            
                            <!-- Data Table Preview -->
                            <Table
                                id="previewTable"
                                items="{import>/data}"
                                growing="true"
                                growingThreshold="10"
                                mode="None">
                                <columns>
                                    <Column id="colId" width="8em">
                                        <Text id="colIdText" text="{i18n>importIdColumn}"/>
                                    </Column>
                                    <Column id="colTitle">
                                        <Text id="colTitleText" text="{i18n>importTitleColumn}"/>
                                    </Column>
                                    <Column id="colRole" width="7em">
                                        <Text id="colRoleText" text="{i18n>importRoleColumn}"/>
                                    </Column>
                                    <Column id="colModule" width="7em">
                                        <Text id="colModuleText" text="{i18n>importModuleColumn}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="previewListItem">
                                        <cells>
                                            <Text id="cellId" text="{import>ID}" wrapping="false"/>
                                            <Text id="cellTitle" text="{import>title}" wrapping="false"/>
                                            <Text id="cellRole" text="{import>role}"/>
                                            <Text id="cellModule" text="{import>sap_module}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </content>
                </Panel>
                
                <!-- Validation Messages -->
                <Panel
                    id="validationPanel"
                    headerText="{i18n>validationResults}"
                    expandable="true"
                    expanded="true"
                    visible="false"
                    class="sapUiSmallMarginTop">
                    <content>
                        <List
                            id="errorList"
                            items="{import>/errors}"
                            noDataText="{i18n>noErrors}">
                            <StandardListItem
                                id="errorListItem"
                                title="{import>message}"
                                icon="sap-icon://error"
                                type="Inactive"/>
                        </List>
                        <List
                            id="warningList"
                            items="{import>/warnings}"
                            noDataText="{i18n>noWarnings}"
                            class="sapUiSmallMarginTop">
                            <StandardListItem
                                id="warningListItem"
                                title="{import>message}"
                                icon="sap-icon://alert"
                                type="Inactive"/>
                        </List>
                    </content>
                </Panel>
                
                <!-- Progress Indicator -->
                <VBox
                    id="progressBox"
                    visible="false"
                    class="sapUiSmallMarginTop">
                    <ProgressIndicator
                        id="importProgress"
                        percentValue="0"
                        displayValue="{i18n>importing}"
                        showValue="true"
                        state="Information"/>
                    <Text
                        id="progressText"
                        text="{i18n>processingRecords}"
                        class="sapUiTinyMarginTop"/>
                </VBox>
                
                <!-- Success Message -->
                <MessageStrip
                    id="successMessage"
                    text="{i18n>importSuccess}"
                    type="Success"
                    showIcon="true"
                    visible="false"
                    class="sapUiSmallMarginTop"/>
                
                <!-- Error Message -->
                <MessageStrip
                    id="errorMessage"
                    text=""
                    type="Error"
                    showIcon="true"
                    visible="false"
                    class="sapUiSmallMarginTop"/>
                    
            </VBox>
        </content>
        
        <beginButton>
            <Button
                id="importButton"
                text="{i18n>importButton}"
                type="Emphasized"
                press=".onImport"
                enabled="false"/>
        </beginButton>
        
        <endButton>
            <Button
                id="cancelImportButton"
                text="{i18n>cancelButton}"
                press=".onCloseImportDialog"/>
        </endButton>
        
    </Dialog>
    
</core:FragmentDefinition>
