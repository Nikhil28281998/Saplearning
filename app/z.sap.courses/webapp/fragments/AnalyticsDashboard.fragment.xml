<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Dialog
        id="analyticsDashboardDialog"
        title="{i18n>analyticsDashboardTitle}"
        stretch="false"
        class="analyticsDashboardDialog"
        contentHeight="85%"
        contentWidth="90%">

        <subHeader>
            <Toolbar id="dashSubHeader">
                <core:Icon src="sap-icon://business-objects-experience" size="1.125rem" color="#0854a0" />
                <Title id="dashSubTitle" text="{i18n>analyticsDashboardSubtitle}" level="H5" />
                <ToolbarSpacer />
                <Button id="dashExportBtn" icon="sap-icon://excel-attachment" text="{i18n>exportReport}"
                    press="onExportTeamReport" type="Ghost" />
            </Toolbar>
        </subHeader>

        <content>
            <ScrollContainer id="dashScrollContainer" height="100%" vertical="true" horizontal="false">
                <VBox id="dashMainContainer" class="sapUiSmallMargin">

                    <!-- ====== QUICK STATS BAR ====== -->
                    <HBox id="dashQuickStats" class="dashQuickStatsRow sapUiSmallMarginBottom" wrap="Wrap" justifyContent="Center">
                        <VBox class="dashQuickStatCard dashQuickBlue" alignItems="Center">
                            <ObjectNumber id="dashQSTotal" number="{teamAnalytics>/totalAssignments}" class="dashQSNumber" />
                            <Text text="Total" class="dashQSLabel" />
                        </VBox>
                        <VBox class="dashQuickStatCard dashQuickOrange" alignItems="Center">
                            <ObjectNumber id="dashQSAssigned" number="{teamAnalytics>/assigned}" class="dashQSNumber" />
                            <Text text="Pending" class="dashQSLabel" />
                        </VBox>
                        <VBox class="dashQuickStatCard dashQuickTeal" alignItems="Center">
                            <ObjectNumber id="dashQSInProgress" number="{teamAnalytics>/inProgress}" class="dashQSNumber" />
                            <Text text="In Progress" class="dashQSLabel" />
                        </VBox>
                        <VBox class="dashQuickStatCard dashQuickGreen" alignItems="Center">
                            <ObjectNumber id="dashQSCompleted" number="{teamAnalytics>/completed}" class="dashQSNumber" />
                            <Text text="Completed" class="dashQSLabel" />
                        </VBox>
                        <VBox class="dashQuickStatCard dashQuickRed" alignItems="Center">
                            <ObjectNumber id="dashQSOverdue" number="{teamAnalytics>/overdue}" class="dashQSNumber" />
                            <Text text="Overdue" class="dashQSLabel" />
                        </VBox>
                        <VBox class="dashQuickStatCard dashQuickPurple" alignItems="Center">
                            <ObjectNumber id="dashQSPct" number="{teamAnalytics>/completionPercent}" unit="%" class="dashQSNumber" />
                            <Text text="Completion" class="dashQSLabel" />
                        </VBox>
                    </HBox>

                    <!-- ====== STATUS DISTRIBUTION BAR ====== -->
                    <VBox id="dashStatusDistPanel" class="dashChartPanel sapUiSmallMarginBottom">
                        <Toolbar id="dashStatusDistToolbar" class="sapUiTinyMarginBottom">
                            <core:Icon src="sap-icon://horizontal-bar-chart" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                            <Title id="dashStatusDistTitle" text="Status Distribution" level="H5" />
                        </Toolbar>
                        <HBox id="dashStatusBars" class="dashStatusBarsContainer" justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="dashStatusBarItem" width="100%">
                                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                    <Text text="Assigned / Pending" class="dashStatusBarLabel" />
                                    <Text text="{= ${teamAnalytics>/assigned} + ' (' + (${teamAnalytics>/totalAssignments} > 0 ? Math.round(${teamAnalytics>/assigned} / ${teamAnalytics>/totalAssignments} * 100) : 0) + '%)'}" class="dashStatusBarValue" />
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{= ${teamAnalytics>/totalAssignments} > 0 ? Math.round(${teamAnalytics>/assigned} / ${teamAnalytics>/totalAssignments} * 100) : 0 }"
                                    state="Warning" showValue="false" height="0.75rem" />
                                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom sapUiSmallMarginTop">
                                    <Text text="In Progress" class="dashStatusBarLabel" />
                                    <Text text="{= ${teamAnalytics>/inProgress} + ' (' + (${teamAnalytics>/totalAssignments} > 0 ? Math.round(${teamAnalytics>/inProgress} / ${teamAnalytics>/totalAssignments} * 100) : 0) + '%)'}" class="dashStatusBarValue" />
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{= ${teamAnalytics>/totalAssignments} > 0 ? Math.round(${teamAnalytics>/inProgress} / ${teamAnalytics>/totalAssignments} * 100) : 0 }"
                                    state="Information" showValue="false" height="0.75rem" />
                                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom sapUiSmallMarginTop">
                                    <Text text="Completed" class="dashStatusBarLabel" />
                                    <Text text="{= ${teamAnalytics>/completed} + ' (' + (${teamAnalytics>/totalAssignments} > 0 ? Math.round(${teamAnalytics>/completed} / ${teamAnalytics>/totalAssignments} * 100) : 0) + '%)'}" class="dashStatusBarValue" />
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{= ${teamAnalytics>/totalAssignments} > 0 ? Math.round(${teamAnalytics>/completed} / ${teamAnalytics>/totalAssignments} * 100) : 0 }"
                                    state="Success" showValue="false" height="0.75rem" />
                                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom sapUiSmallMarginTop">
                                    <Text text="Overdue" class="dashStatusBarLabel" />
                                    <Text text="{= ${teamAnalytics>/overdue} + ' (' + (${teamAnalytics>/totalAssignments} > 0 ? Math.round(${teamAnalytics>/overdue} / ${teamAnalytics>/totalAssignments} * 100) : 0) + '%)'}" class="dashStatusBarValue" />
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{= ${teamAnalytics>/totalAssignments} > 0 ? Math.round(${teamAnalytics>/overdue} / ${teamAnalytics>/totalAssignments} * 100) : 0 }"
                                    state="Error" showValue="false" height="0.75rem" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox id="dashChartsContainer" class="dashChartsContainer" wrap="Wrap">

                        <!-- ====== MODULE DISTRIBUTION ====== -->
                        <VBox id="dashModulePanel" class="dashChartPanel sapUiSmallMarginEnd sapUiSmallMarginBottom">
                            <Toolbar id="dashModuleToolbar" class="sapUiTinyMarginBottom">
                                <core:Icon src="sap-icon://bar-chart" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd" />
                                <Title id="dashModuleTitle" text="{i18n>dashModuleDistribution}" level="H5" />
                            </Toolbar>
                            <!-- Assignment-based module stats (primary) -->
                            <VBox id="dashModuleAssignList"
                                items="{teamAnalytics>/moduleAssignmentStats}"
                                visible="{= !!${teamAnalytics>/moduleAssignmentStats} }"
                                class="dashModuleList">
                                <items>
                                    <HBox alignItems="Center" class="dashModuleRow">
                                        <core:Icon src="sap-icon://tree" size="0.875rem" class="sapUiTinyMarginEnd dashModuleIcon" />
                                        <Text text="{teamAnalytics>label}" class="dashModuleLabel" wrapping="false" />
                                        <ProgressIndicator
                                            percentValue="{teamAnalytics>completionPct}"
                                            displayValue="{teamAnalytics>displayValue}"
                                            state="{= ${teamAnalytics>completionPct} >= 80 ? 'Success' : ${teamAnalytics>completionPct} >= 50 ? 'Warning' : 'Error' }"
                                            showValue="true"
                                            width="100%"
                                            height="1.25rem"
                                            class="dashModuleBar" />
                                        <ObjectStatus
                                            text="{= ${teamAnalytics>overdue} > 0 ? ${teamAnalytics>overdue} + ' !' : '' }"
                                            state="Error"
                                            visible="{= ${teamAnalytics>overdue} > 0 }"
                                            class="sapUiTinyMarginBegin" />
                                    </HBox>
                                </items>
                            </VBox>
                            <!-- Fallback: training catalog module distribution -->
                            <VBox id="dashModuleCatalogList"
                                items="{analyticsModel>/moduleDistribution}"
                                visible="{= !${teamAnalytics>/moduleAssignmentStats} || ${teamAnalytics>/moduleAssignmentStats}.length === 0 }"
                                class="dashModuleList">
                                <items>
                                    <HBox alignItems="Center" class="dashModuleRow">
                                        <core:Icon src="sap-icon://tree" size="0.875rem" class="sapUiTinyMarginEnd dashModuleIcon" />
                                        <Text text="{analyticsModel>label}" class="dashModuleLabel" wrapping="false" />
                                        <ProgressIndicator
                                            percentValue="{analyticsModel>percentOfMax}"
                                            displayValue="{analyticsModel>displayValue}"
                                            state="Information"
                                            showValue="true"
                                            width="100%"
                                            height="1.25rem"
                                            class="dashModuleBar" />
                                    </HBox>
                                </items>
                            </VBox>
                            <Text id="dashModuleNoData" text="{i18n>noModuleData}" class="dashNoData"
                                visible="{= (!${teamAnalytics>/moduleAssignmentStats} || ${teamAnalytics>/moduleAssignmentStats}.length === 0) &amp;&amp; (!${analyticsModel>/moduleDistribution} || ${analyticsModel>/moduleDistribution}.length === 0) }" />
                        </VBox>

                        <!-- ====== TEAM MEMBER PROGRESS ====== -->
                        <VBox id="dashUserPanel" class="dashChartPanel sapUiSmallMarginBottom">
                            <Toolbar id="dashUserToolbar" class="sapUiTinyMarginBottom">
                                <core:Icon src="sap-icon://customer" size="1rem" color="#0a6ed1" class="sapUiTinyMarginEnd" />
                                <Title id="dashUserTitle" text="{i18n>dashTeamProgress}" level="H5" />
                                <ToolbarSpacer />
                                <Text id="dashUserCount" text="{= ${teamAnalytics>/userBreakdown} ? ${teamAnalytics>/userBreakdown}.length + ' members' : '' }" class="dashUserCountText" />
                            </Toolbar>
                            <VBox id="dashUserList"
                                items="{teamAnalytics>/userBreakdown}"
                                class="dashUserList">
                                <items>
                                    <HBox alignItems="Center" class="dashUserRow">
                                        <core:Icon src="sap-icon://person-placeholder" size="1rem" class="sapUiTinyMarginEnd dashUserIcon" />
                                        <VBox class="dashUserInfo">
                                            <Text text="{teamAnalytics>userName}" class="dashUserName" wrapping="false" />
                                            <Text text="{teamAnalytics>userId}" class="dashUserId" wrapping="false" />
                                        </VBox>
                                        <ProgressIndicator
                                            percentValue="{= ${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0 }"
                                            displayValue="{= ${teamAnalytics>completed} + '/' + ${teamAnalytics>total} + ' done' }"
                                            state="{= (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) >= 100 ? 'Success' : (${teamAnalytics>total} > 0 ? Math.round(${teamAnalytics>completed} / ${teamAnalytics>total} * 100) : 0) >= 50 ? 'Warning' : 'Error' }"
                                            showValue="true"
                                            width="100%"
                                            height="1.25rem"
                                            class="dashUserBar" />
                                        <VBox alignItems="End" class="dashUserStats">
                                            <ObjectStatus
                                                text="{= ${teamAnalytics>inProgress} > 0 ? ${teamAnalytics>inProgress} + ' active' : '' }"
                                                state="Information"
                                                visible="{= ${teamAnalytics>inProgress} > 0 }"
                                                class="dashUserStat" />
                                            <ObjectStatus
                                                text="{= ${teamAnalytics>overdue} > 0 ? ${teamAnalytics>overdue} + ' overdue' : '' }"
                                                state="Error"
                                                visible="{= ${teamAnalytics>overdue} > 0 }"
                                                class="dashUserStat" />
                                        </VBox>
                                    </HBox>
                                </items>
                            </VBox>
                            <Text id="dashUserNoData" text="{i18n>noTeamMembers}" class="dashNoData"
                                visible="{= !${teamAnalytics>/userBreakdown} || ${teamAnalytics>/userBreakdown}.length === 0 }" />
                        </VBox>

                    </HBox>
                </VBox>
            </ScrollContainer>
        </content>

        <endButton>
            <Button id="dashCloseBtn" text="{i18n>close}" press="onCloseAnalyticsDashboard" type="Emphasized" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
