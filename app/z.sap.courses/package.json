{
  "name": "z.sap.courses",
  "version": "0.0.1",
  "description": "SAP Courses UI - S/4HANA Embedded",
  "main": "webapp/index.html",
  "devDependencies": {
    "@sap/ux-ui5-tooling": "^1",
    "@ui5/cli": "^3",
    "ui5-task-zipper": "^3.1.3"
  },
  "ui5": {
    "dependencies": []
  },
  "sapux": true,
  "scripts": {
    "start": "fiori run --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#zsapcourses-display\"",
    "start:local": "fiori run --config ./ui5-local.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#zsapcourses-display\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy": "fiori deploy --config ui5-deploy.yaml && npm run deploy:undeploy:backup",
    "deploy:undeploy:backup": "rimraf dist-zip && bestzip dist-zip/Z_COURSES_UI.zip dist/*",
    "deploy:config": "fiori add deploy-config"
  }
}
