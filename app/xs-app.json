{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "compression": {
    "enabled": true,
    "minSize": 2048
  },
  "routes": [
    {
      "source": "^/(index\\.html)?$",
      "target": "saplearningcenter.saplearningcenter/index.html",
      "localDir": ".",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/service/(.*)$",
      "target": "/service/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/saplearningcenter.saplearningcenter/(.*)$",
      "target": "$1",
      "localDir": "saplearningcenter.saplearningcenter",
      "authenticationType": "xsuaa",
      "cacheControl": "public, max-age=31536000"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": ".",
      "authenticationType": "xsuaa"
    }
  ],
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/"
  }
}
