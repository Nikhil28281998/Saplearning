{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "compression": {
    "enabled": true,
    "minSize": 2048
  },
  "routes": [
    {
      "source": "^/$",
      "target": "/saplearningcenter.saplearningcenter/webapp/index.html",
      "localDir": ".",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/service/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/saplearningcenter.saplearningcenter/(.*)$",
      "target": "$1",
      "localDir": "saplearningcenter.saplearningcenter/webapp",
      "authenticationType": "xsuaa",
      "cacheControl": "public, max-age=31536000"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": ".",
      "authenticationType": "xsuaa"
    }
  ],
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/"
  },
  "cors": [
    {
      "uriPattern": "^/service/.*$",
      "allowedOrigins": [
        {
          "host": "*.cfapps.*.hana.ondemand.com",
          "protocol": "https"
        }
      ],
      "allowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH"],
      "allowedHeaders": ["Content-Type", "Authorization", "X-CSRF-Token"],
      "exposeHeaders": ["X-CSRF-Token"]
    }
  ]
}
