{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "service": "html5-apps-repo-rt"
    },
    {
      "source": "^/api/(.*)$",
      "target": "/$1",
      "destination": "ULHN_API"
    },
    {
      "source": "^/ai/(.*)$",
      "target": "/$1",
      "destination": "ai-destination"
    }
  ]
}
