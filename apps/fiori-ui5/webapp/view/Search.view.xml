<mvc:View
  controllerName="ulhn.app.controller.Search"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core">
  <Page title="Search">
    <content>
      <Toolbar class="sapUiSmallMargin">
        <Label text="Role" labelFor="roleSelect"/>
        <Select id="roleSelect" width="12rem" items="{meta>/roles}">
          <core:Item key="{meta>}" text="{meta>}" />
        </Select>
        <ToolbarSeparator/>
        <Label text="Module" labelFor="moduleSelect"/>
        <Select id="moduleSelect" width="16rem" items="{meta>/modules}">
          <core:Item key="{meta>}" text="{meta>}" />
        </Select>
        <ToolbarSpacer/>
        <Button text="Go" type="Emphasized" press="onGo"/>
        <Button text="Reset" press="onReset"/>
        <Button text="Adapt Filters" press="onAdaptFilters"/>
        <Button text="Settings" press="onSettings"/>
        <Button text="Export" icon="sap-icon://excel-attachment" press="onExport"/>
      </Toolbar>

      <VBox class="sapUiMediumMargin">
        <Title level="H5" text="Results"/>
        <Table id="resultsTable" inset="false">
          <columns>
            <Column visible="{/columnVisibility/id}"><Text text="id"/></Column>
            <Column visible="{/columnVisibility/title}"><Text text="title"/></Column>
            <Column visible="{/columnVisibility/role}"><Text text="role"/></Column>
            <Column visible="{/columnVisibility/module}"><Text text="module"/></Column>
            <Column demandPopin="true" visible="{/columnVisibility/description}"><Text text="description"/></Column>
            <Column width="10rem" visible="{/columnVisibility/lastUpdated}"><Text text="lastUpdated"/></Column>
            <Column demandPopin="true" visible="{/columnVisibility/sapHelpLink}"><Text text="sapHelpLink"/></Column>
            <Column width="12rem" hAlign="End" visible="{/columnVisibility/actions}"><Text text="Actions"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <Text text="{id}"/>
              <ObjectIdentifier title="{title}" text="{url}"/>
              <Text text="{role}"/>
              <Text text="{module}"/>
              <Text text="{description}"/>
              <Text text="{path: 'lastUpdated', type: 'sap.ui.model.type.Date', formatOptions: {style: 'medium'}}"/>
              <Link text="Open" href="{sapHelpLink}" target="_blank"/>
              <HBox justifyContent="End">
                <Button text="Open" type="Transparent" press="onOpen"/>
                <Button icon="sap-icon://favorite" type="Transparent" press="onFav"/>
              </HBox>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
