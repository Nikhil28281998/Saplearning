<mvc:View
  controllerName="ulhn.app.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout">
  <Page title="Dashboard">
    <content>
      <VBox class="sapUiMediumMargin">
        <Title level="H4" text="Modules"/>
        <TileContainer id="modulesTiles" tiles="{meta>/modules}">
          <GenericTile
            header="{meta>}"
            press="onModuleTilePress"
            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
            <TileContent unit="Module">
              <NumericContent value="" withMargin="false"/>
            </TileContent>
          </GenericTile>
        </TileContainer>
      </VBox>

      <VBox class="sapUiMediumMarginTop">
        <Title level="H4" text="Quick Actions"/>
        <HBox>
          <Button text="Search" icon="sap-icon://search" press="onGoSearch" class="sapUiTinyMarginEnd"/>
          <Button text="Training" icon="sap-icon://learning-assistant" press="onGoTraining"/>
        </HBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
