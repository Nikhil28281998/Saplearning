{
	"name": "sap-learning-courses",
	"version": "2.0.1",
	"description": "SAP Learning Courses Platform - S4HANA On-Premise",
	"repository": "https://github.com/Nikhil28281998/Saplearning",
	"license": "UNLICENSED",
	"dependencies": {
		"@sap/cds": "^8",
		"express": "^4",
		"express-rate-limit": "^7.5.1",
		"helmet": "^7",
		"passport": "^0.7",
		"xss": "^1.0"
	},
	"devDependencies": {
		"@sap/cds-dk": "^8",
		"sqlite3": "^5.1.7"
	},
	"scripts": {
		"start": "cds-serve",
		"watch": "cds watch",
		"build": "cds build --production",
		"test": "cd app/z.sap.courses && ui5 serve --open test/unit/unitTests.qunit.html",
		"test:integration": "cd app/z.sap.courses && ui5 serve --open test/integration/opaTests.qunit.html"
	},
	"cds": {
		"requires": {
			"db": {
				"kind": "sql",
				"schema_evolution": "auto"
			},
			"auth": {
				"[production]": {
					"kind": "basic"
				},
				"[development]": {
					"kind": "mocked",
					"users": {
						"admin@test.com": {
							"password": "admin",
							"roles": ["Admin"],
							"attr": { "sapUsername": "ADMIN001" }
						},
						"manager@test.com": {
							"password": "manager",
							"roles": ["Manager"],
							"attr": { "sapUsername": "MGR001" }
						},
						"user@test.com": {
							"password": "user",
							"roles": ["User"],
							"attr": { "sapUsername": "USER001" }
						}
					}
				}
			}
		},
		"features": {
			"serve_on_root": false
		}
	},
	"sapux": [
		"app/z.sap.courses"
	]
}
