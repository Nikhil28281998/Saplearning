# S/4HANA System Configuration
# Copy this file to .env and fill in your actual S/4 system details
# NOTE: Never commit .env file - it contains credentials!

# S/4HANA host with protocol (e.g., https://s4h-system.example.com:44300)
S4_HOST=https://YOUR_S4_HOST:PORT

# S/4 client number (e.g., 100)
S4_CLIENT=100

# S/4 user ID for deployment (ABAP user)
S4_USER=DEPLOYMENT_USER

# S/4 user password
S4_PASSWORD=YOUR_PASSWORD

# Transport request number (optional - may be requested during deploy)
# S4_TRANSPORT=DEVK900001

# Local development proxy URL (for testing OData calls locally)
# Leave as default unless testing against local S/4 instance
LOCAL_SAP_PROXY=http://localhost:8080/sap
