# S4HANA On-Premise Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env file with credentials

# ABAP System Connection
FIORI_TOOLS_ABAP_DEPLOY_URL=https://your-s4hana-host:port
FIORI_TOOLS_ABAP_DEPLOY_CLIENT=100
FIORI_TOOLS_ABAP_DEPLOY_AUTH=basic
FIORI_TOOLS_ABAP_DEPLOY_USER=YOUR_USERNAME
FIORI_TOOLS_ABAP_DEPLOY_PASSWORD=YOUR_PASSWORD

# Transport Request (optional - will create if not provided)
FIORI_TOOLS_ABAP_DEPLOY_TRANSPORT=S4DK900001

# Package (Default: ZTMP for development, use Z* or Y* package)
FIORI_TOOLS_ABAP_DEPLOY_PACKAGE=ZTMP

# OData Service Endpoint
ODATA_SERVICE_URL=https://your-s4hana-host:port/sap/opu/odata/sap/
