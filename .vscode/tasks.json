{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kill-cds-processes",
      "type": "shell",
      "command": "pids=$(ps aux | grep -vE 'grep|bash' | grep 'cds.js' | awk '{print $2}'); if [ -n \"$pids\" ]; then kill $pids; fi",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "npm-install",
      "type": "process",
      "command": "npm",
      "args": [
        "install"
      ],
      "dependsOn": [
        "kill-cds-processes"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "BuildMDK",
      "type": "shell",
      "command": "if npm list @sap/mdk-tools --depth=0 > /dev/null 2>&1; then npx mdk build --target module --ui5 --recursive;fi",
      "dependsOn": [
        "npm-install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "type": "dpt.ptdeploy",
      "label": "Deploy Saplearningcenter",
      "taskType": "Deploy"
    },
    {
      "type": "dpt.ptdeploy",
      "label": "Enable Discovery and Deploy Saplearningcenter",
      "taskType": "Deploy",
      "enableDiscovery": "true"
    },
    {
      "type": "build.mta",
      "label": "Build MTA: skillforge-training-platform - PT",
      "taskType": "Build",
      "projectPath": "/home/user/projects/Saplearningcenter",
      "extensions": [],
      "ui5theme": "sap_fiori_3",
      "vendorDependency": false,
      "buildCodeServicePlan": false,
      "subdomain": "",
      "ui5version": "1.143.0"
    },
    {
      "label": "DeployToHANADB:.env1",
      "type": "shell",
      "command": "eval $(cat ${workspaceFolder}/env/.env1) cds deploy --to hana --auto-undeploy",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PreLaunchTask for Run Saplearningcenter",
      "type": "process",
      "command": "npx",
      "args": [
        "dev-cap-tools",
        "gen-entrypoint",
        "--ui5version",
        "1.143.0",
        "--ui5theme",
        "sap_fiori_3"
      ],
      "dependsOn": [
        "npm-install",
        "DeployToHANADB:.env1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}